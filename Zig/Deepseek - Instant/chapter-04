### 8. Examples

#### Example 1: Type inference and `comptime_int` in action

```zig
const std = @import("std");

pub fn main() !void {
    // These are all comptime_int
    const a = 42;
    const b = 0xdeadbeef;
    const c = 1 << 60;

    // Coercion to concrete type – note explicit cast
    const a_u8: u8 = @intCast(a);      // OK, 42 fits
    const b_u32: u32 = @intCast(b);    // 0xdeadbeef fits in u32
    // const bad: u16 = @intCast(c);   // Would panic at compile time (out of range)

    // Runtime values require explicit type
    const random = try std.crypto.random.int(u64);
    const random_u32 = @as(u32, @intCast(random & 0xffff_ffff));

    std.debug.print("a_u8={}, b_u32=0x{X}, random_u32=0x{X}\n", .{ a_u8, b_u32, random_u32 });
}
```

#### Example 2: Mutable pointer vs. immutable binding

```zig
const std = @import("std");

pub fn main() !void {
    var value: u32 = 100;
    const ptr = &value;      // ptr is *u32 (immutable binding to mutable pointer)
    ptr.* += 1;              // ✅ modifies value

    // ptr = &other;         // ❌ cannot reassign ptr (const binding)

    var other: u32 = 200;
    var mut_ptr = &other;    // mut_ptr is *u32 (mutable binding)
    mut_ptr.* += 1;          // ✅ modifies other
    mut_ptr = &value;        // ✅ reassign to point to value
    mut_ptr.* += 10;         // now value becomes 111 (100+1+10)

    // Pointer-to-const example
    const ro_ptr: *const u32 = &value;
    // ro_ptr.* = 999;       // ❌ cannot modify through *const T
    const deref = ro_ptr.*;  // ✅ read-only

    std.debug.print("value={}, other={}\n", .{ value, other });
}
```

#### Example 3: `undefined` with safety check

```zig
const std = @import("std");

pub fn main() !void {
    var x: u8 = undefined;

    // In Debug or ReleaseSafe, this triggers a panic:
    // "attempt to use undefined value"
    // std.debug.print("x={}\n", .{x});

    // Proper usage: overwrite before read
    x = 42;
    std.debug.print("x={}\n", .{x}); // OK

    // Partial initialization of array
    var buf: [10]u8 = undefined;
    for (&buf, 0..) |*b, i| {
        if (i < 5) b.* = @intCast(i);
        // indices 5-9 remain undefined
    }
    // Reading buf[5] later would be unsafe – design must track initialized length
}
```

#### Example 4: Zero-sized type elision

```zig
const std = @import("std");

const Empty = struct {};

pub fn main() !void {
    const e1: Empty = .{};
    const e2: Empty = .{};

    std.debug.print("size of Empty: {}\n", .{@sizeOf(Empty)});  // prints 0
    std.debug.print("address of e1: 0x{X}\n", .{@intFromPtr(&e1)});
    std.debug.print("address of e2: 0x{X}\n", .{@intFromPtr(&e2)});
    // The addresses may be identical (or stack pointer unchanged) because both occupy no space.

    // Array of zero-sized types also has zero size
    var arr: [100]Empty = undefined;
    std.debug.print("size of [100]Empty: {}\n", .{@sizeOf([100]Empty)}); // 0
}
```

