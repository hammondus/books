### 8. Examples

**Example 1: A command parser that aggregates errors from multiple steps**

```zig
const std = @import("std");

const CommandError = error{
    InvalidSyntax,
    UnknownCommand,
    MissingArgument,
};

fn parseCommand(input: []const u8) CommandError!struct { cmd: []const u8, args: []const u8 } {
    var it = std.mem.tokenizeScalar(u8, input, ' ');
    const cmd = it.next() orelse return CommandError.InvalidSyntax;
    const args = it.rest();
    if (!std.mem.eql(u8, cmd, "start") and !std.mem.eql(u8, cmd, "stop"))
        return CommandError.UnknownCommand;
    if (args.len == 0 and std.mem.eql(u8, cmd, "stop") == false)
        return CommandError.MissingArgument;
    return .{ .cmd = cmd, .args = args };
}

pub fn main() !void {
    const tests = [_][]const u8{ "start server", "stop", "unknown x", "" };
    for (tests) |t| {
        const result = parseCommand(t);
        if (result) |cmd| {
            std.debug.print("OK: cmd='{s}', args='{s}'\n", .{ cmd.cmd, cmd.args });
        } else |err| {
            std.debug.print("ERR: {s}\n", .{ @errorName(err) });
        }
    }
}
```

**Example 2: A generic retry loop with exponential backoff (simplified)**

```zig
fn retry(comptime func: anytype, max_attempts: usize) !@typeInfo(@TypeOf(func)).Fn.return_type.? {
    var attempt: usize = 0;
    while (attempt < max_attempts) : (attempt += 1) {
        const result = func();
        if (result) |success| return success else |err| {
            if (attempt + 1 == max_attempts) return err;
            std.time.sleep(1 << @as(u32, @intCast(attempt)) * std.time.ns_per_ms);
            continue;
        }
    }
    unreachable;
}

fn unreliableOperation() !u32 {
    if (std.crypto.random.int(u32) % 2 == 0) return error.TemporaryFailure;
    return 42;
}

test "retry eventually succeeds" {
    const val = try retry(unreliableOperation, 10);
    try std.testing.expectEqual(@as(u32, 42), val);
}
```

**Example 3: Converting a C-style error code to an error union**

```zig
// Simulating a C API
const C_ERR_NONE = 0;
const C_ERR_NOT_FOUND = 1;
const C_ERR_ACCESS = 2;

fn c_like_open(path: [*:0]const u8) callconv(.C) i32 {
    _ = path;
    // mock: always return not found
    return C_ERR_NOT_FOUND;
}

const MyError = error{NotFound, AccessDenied};

fn safeOpen(path: [*:0]const u8) MyError!void {
    const rc = c_like_open(path);
    return switch (rc) {
        C_ERR_NONE => {},
        C_ERR_NOT_FOUND => MyError.NotFound,
        C_ERR_ACCESS => MyError.AccessDenied,
        else => unreachable, // unknown error from C stub
    };
}
```

**Example 4: Compile-time validation of error handling**

```zig
fn mustSucceed(comptime func: anytype) void {
    const ReturnType = @typeInfo(@TypeOf(func)).Fn.return_type.?;
    if (@typeInfo(ReturnType) != .ErrorUnion) {
        @compileError("mustSucceed requires a function that returns an error union");
    }
    // comptime check that the error set is empty (cannot fail)
    // This is a contrived demonstration; in practice you'd call @typeInfo on the error set.
}

fn alwaysWorks() !void {
    return; // success only, error set is error{}
}

comptime {
    mustSucceed(alwaysWorks); // passes
    // mustSucceed(parseNumber); // would fail at compile time
}
```

