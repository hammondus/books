## 8. Examples

### Example 1: Generating a Type-Safe Command Parser

```zig
const std = @import("std");

fn CommandDescriptor(comptime name: []const u8, comptime args: anytype) type {
    return struct {
        const Name = name;
        const Args = args;
    };
}

fn buildParser(comptime commands: anytype) type {
    var cmd_map: [commands.len]struct { []const u8, type } = undefined;
    inline for (commands, 0..) |cmd, i| {
        cmd_map[i] = .{ cmd.Name, cmd };
    }
    // Sort for binary search (compile time)
    comptime std.sort.block(cmd_map, struct {
        fn less(ctx: void, a: @TypeOf(cmd_map[0]), b: @TypeOf(cmd_map[0])) bool {
            _ = ctx;
            return std.mem.lessThan(u8, a[0], b[0]);
        }
    }.less, {});

    return struct {
        pub fn parse(allocator: std.mem.Allocator, args: []const []const u8) !void {
            if (args.len == 0) return error.MissingCommand;
            const cmd_name = args[0];
            const idx = comptime blk: {
                for (cmd_map, 0..) |pair, i| {
                    if (std.mem.eql(u8, pair[0], cmd_name)) break :blk i;
                }
                break :blk null;
            };
            if (idx) |i| {
                const CmdType = cmd_map[i][1];
                var cmd: CmdType = undefined;
                // Assume CmdType has an init function
                _ = &cmd;
                std.debug.print("Executing command: {s}\n", .{cmd_name});
            } else {
                return error.UnknownCommand;
            }
        }
    };
}

const commands = .{
    CommandDescriptor("serve", struct { port: u16 }),
    CommandDescriptor("build", struct { target: []const u8 }),
};
const Parser = buildParser(commands);

pub fn main() !void {
    try Parser.parse(std.heap.page_allocator, &[_][]const u8{"serve"});
}
```

### Example 2: Compile-Time Regex Matcher (Simplified)

```zig
const std = @import("std");

fn compileRegex(comptime pattern: []const u8) type {
    comptime var i: usize = 0;
    comptime var states = std.BoundedArray(struct { char: u8, next: usize }, 256){};
    while (i < pattern.len) : (i += 1) {
        const c = pattern[i];
        try states.append(.{ .char = c, .next = i + 1 });
    }
    const States = states.toOwnedSlice();
    return struct {
        pub fn match(str: []const u8) bool {
            var pos: usize = 0;
            for (str) |ch| {
                if (pos >= States.len) return false;
                if (ch != States[pos].char) return false;
                pos = States[pos].next;
            }
            return pos == States.len;
        }
    };
}

const Matcher = compileRegex("hello");
test "regex match" {
    try std.testing.expect(Matcher.match("hello"));
    try std.testing.expect(!Matcher.match("world"));
}
```

### Example 3: Type-Safe Enum to String Map with Compile-Time Validation

```zig
const std = @import("std");

fn EnumStrings(comptime E: type, comptime strings: []const []const u8) type {
    const fields = std.meta.fields(E);
    comptime if (fields.len != strings.len) {
        @compileError("Number of strings must match enum fields");
    }
    inline for (fields, strings) |field, str| {
        if (!std.mem.eql(u8, field.name, str)) {
            @compileError(std.fmt.comptimePrint("String for {s} must be '{s}'", .{field.name, field.name}));
        }
    }
    return struct {
        pub fn toString(e: E) []const u8 {
            return strings[@intFromEnum(e)];
        }
        pub fn fromString(str: []const u8) !E {
            inline for (fields, 0..) |field, i| {
                if (std.mem.eql(u8, strings[i], str)) {
                    return @enumFromInt(i);
                }
            }
            return error.InvalidEnumString;
        }
    };
}

const Color = enum { red, green, blue };
const ColorStrings = EnumStrings(Color, .{ "red", "green", "blue" });

test "enum strings" {
    try std.testing.expectEqualStrings("green", ColorStrings.toString(.green));
    try std.testing.expectEqual(@as(Color, .blue), try ColorStrings.fromString("blue"));
}
```

