### 14.8 Examples

Each of the following examples is a complete, runnable program.

#### Example 1: Leak Detection with GPA

```zig
const std = @import("std");

pub fn main() !void {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit(); // prints leak report if any memory is not freed

    const allocator = gpa.allocator();
    const arr = try allocator.alloc(u32, 100);
    defer allocator.free(arr);

    for (arr, 0..) |*val, i| {
        val.* = @intCast(i);
    }

    std.debug.print("arr[42] = {}\n", .{arr[42]});
}
```

#### Example 2: Arena for Parsing Many Objects

```zig
const std = @import("std");

const Point = struct { x: i32, y: i32 };

fn readPoints(arena_allocator: std.mem.Allocator, data: []const u8) ![]Point {
    var list = std.ArrayList(Point).init(arena_allocator);
    defer list.deinit();

    var it = std.mem.tokenizeAny(u8, data, " ;\n");
    while (it.next()) |token| {
        if (std.mem.indexOfScalar(u8, token, ',')) |comma| {
            const x_str = token[0..comma];
            const y_str = token[comma + 1 ..];
            const x = try std.fmt.parseInt(i32, x_str, 10);
            const y = try std.fmt.parseInt(i32, y_str, 10);
            try list.append(Point{ .x = x, .y = y });
        }
    }
    return try list.toOwnedSlice();
}

pub fn main() !void {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();

    var arena = std.heap.ArenaAllocator.init(gpa.allocator());
    defer arena.deinit();
    const allocator = arena.allocator();

    const input = "1,2 ; 3,4\n5,6";
    const points = try readPoints(allocator, input);
    // points lives until arena.deinit() – no need to free individually.
    for (points) |p| {
        std.debug.print("({}, {})\n", .{ p.x, p.y });
    }
}
```

#### Example 3: FixedBufferAllocator for No‑Alloc Parsing

```zig
const std = @import("std");

const MaxTokens = 64;
const MaxTokenLen = 32;

pub fn splitIntoStaticBuffer(buffer: []u8, separator: u8, output: []const []u8) usize {
    var fba = std.heap.FixedBufferAllocator.init(buffer);
    const allocator = fba.allocator();

    var list = std.ArrayList([]u8).init(allocator);
    defer list.deinit();

    var start: usize = 0;
    for (buffer, 0..) |ch, i| {
        if (ch == separator) {
            const slice = buffer[start..i];
            list.append(slice) catch |err| {
                std.debug.print("out of space: {}\n", .{err});
                break;
            };
            start = i + 1;
        }
    }
    if (start < buffer.len) {
        list.append(buffer[start..]) catch {};
    }
    const result = list.items;
    @memcpy(output[0..result.len], result);
    return result.len;
}

pub fn main() !void {
    var storage: [128]u8 = undefined;
    var token_ptrs: [MaxTokens][]u8 = undefined;

    const src = "hello:world:zig:allocators";
    @memcpy(storage[0..src.len], src);
    const count = splitIntoStaticBuffer(storage[0..src.len], ':', token_ptrs[0..]);

    for (token_ptrs[0..count]) |tok| {
        std.debug.print("token: {s}\n", .{tok});
    }
}
```

#### Example 4: Custom Allocator – Counting Allocations

```zig
const std = @import("std");

pub const CountingAllocator = struct {
    backing: std.mem.Allocator,
    allocations: usize,
    deallocations: usize,
    current_bytes: usize,
    peak_bytes: usize,

    pub fn init(backing: std.mem.Allocator) CountingAllocator {
        return CountingAllocator{
            .backing = backing,
            .allocations = 0,
            .deallocations = 0,
            .current_bytes = 0,
            .peak_bytes = 0,
        };
    }

    pub fn allocator(self: *CountingAllocator) std.mem.Allocator {
        return std.mem.Allocator.init(self, struct {
            fn alloc(ctx: *anyopaque, len: usize, log2_align: u8, ra: usize) ?[*]u8 {
                const self_ptr: *CountingAllocator = @ptrCast(@alignCast(ctx));
                const ptr = self_ptr.backing.rawAlloc(len, log2_align, ra) orelse return null;
                self_ptr.allocations += 1;
                self_ptr.current_bytes += len;
                if (self_ptr.current_bytes > self_ptr.peak_bytes) {
                    self_ptr.peak_bytes = self_ptr.current_bytes;
                }
                return ptr;
            }
            fn resize(ctx: *anyopaque, buf: []u8, log2_align: u8, new_len: usize, ra: usize) bool {
                const self_ptr: *CountingAllocator = @ptrCast(@alignCast(ctx));
                return self_ptr.backing.rawResize(buf, log2_align, new_len, ra);
            }
            fn free(ctx: *anyopaque, buf: []u8, log2_align: u8, ra: usize) void {
                const self_ptr: *CountingAllocator = @ptrCast(@alignCast(ctx));
                self_ptr.deallocations += 1;
                self_ptr.current_bytes -= buf.len;
                self_ptr.backing.rawFree(buf, log2_align, ra);
            }
        });
    }
};

pub fn main() !void {
    var backing_gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = backing_gpa.deinit();
    var counter = CountingAllocator.init(backing_gpa.allocator());
    const allocator = counter.allocator();

    const a = try allocator.alloc(u8, 100);
    defer allocator.free(a);
    const b = try allocator.alloc(u8, 200);
    defer allocator.free(b);

    std.debug.print("allocations: {}, deallocations: {}, peak bytes: {}\n", .{
        counter.allocations,
        counter.deallocations,
        counter.peak_bytes,
    });
}
```

