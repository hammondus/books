### 8. Examples

#### Example 1: Particle System – AoS vs. SoA Comparison

This example builds two versions of a particle update loop and prints the iteration time. (In a real benchmark, you would use `std.time.Timer` and run many iterations.)

```zig
const std = @import("std");

const Particle = struct {
    x: f32, y: f32, vx: f32, vy: f32, mass: f32, active: bool,
};

pub fn main() !void {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const ally = gpa.allocator();

    const N = 5_000_000;
    // --- AoS version: slice of structs ---
    var aos = try ally.alloc(Particle, N);
    defer ally.free(aos);
    for (aos) |*p| {
        p.* = .{ .x = 0, .y = 0, .vx = 1, .vy = 0, .mass = 1, .active = true };
    }

    // --- SoA version: MultiArrayList ---
    var soa = std.MultiArrayList(Particle){};
    defer soa.deinit(ally);
    try soa.resize(ally, N);
    for (soa.items(.vx)) |*vx| vx.* = 1.0;
    for (soa.items(.vy)) |*vy| vy.* = 0.0;
    // ... set other fields similarly

    // Update loop AoS
    var timer = try std.time.Timer.start();
    for (aos) |*p| {
        p.x += p.vx;
        p.y += p.vy;
        // (simplified – no dt)
    }
    const aos_ns = timer.read();
    std.debug.print("AoS update took {} ns\n", .{aos_ns});

    // Update loop SoA
    timer.reset();
    const xs = soa.items(.x);
    const ys = soa.items(.y);
    const vxs = soa.items(.vx);
    const vys = soa.items(.vy);
    for (xs, ys, vxs, vys) |*x, *y, vx, vy| {
        x.* += vx;
        y.* += vy;
    }
    const soa_ns = timer.read();
    std.debug.print("SoA update took {} ns\n", .{soa_ns});
}
```

#### Example 2: BoundedArray for a Stack‑Based Command Buffer

```zig
const std = @import("std");

const Command = enum { Noop, Write, Read, Flush };

fn runCommands(commands: []const Command) void {
    for (commands) |cmd| {
        switch (cmd) {
            .Noop => {},
            .Write => std.debug.print("write\n", .{}),
            .Read => std.debug.print("read\n", .{}),
            .Flush => std.debug.print("flush\n", .{}),
        }
    }
}

pub fn main() !void {
    // Maximum number of commands known at compile time: 32
    var buf = std.BoundedArray(Command, 32){};
    try buf.append(.Write);
    try buf.append(.Read);
    try buf.append(.Flush);
    runCommands(buf.slice());
}
```

#### Example 3: StaticBitSet for Fast Object Allocation (Handled IDs)

```zig
const std = @import("std");

const MAX_OBJECTS = 1024;

const ObjectPool = struct {
    used: std.StaticBitSet(MAX_OBJECTS),
    objects: [MAX_OBJECTS]u64, // dummy data
    next_free: usize = 0,

    fn alloc(self: *ObjectPool) ?usize {
        // Find first free slot using bitset
        const index = self.used.findFirstSetBit() orelse return null;
        self.used.unset(index);
        return index;
    }

    fn free(self: *ObjectPool, idx: usize) void {
        self.used.set(idx);
    }
};

pub fn main() void {
    var pool = ObjectPool{
        .used = std.StaticBitSet(MAX_OBJECTS).initFull(), // all free
        .objects = undefined,
    };
    const id = pool.alloc() orelse return;
    defer pool.free(id);

    std.debug.print("Allocated object {}\n", .{id});
}
```

