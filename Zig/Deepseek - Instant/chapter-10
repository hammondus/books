## 10.8 Examples

### Example 1: In‑Place Slice Reversal

```zig
const std = @import("std");

fn reverse(slice: []u8) void {
    var i: usize = 0;
    while (i < slice.len / 2) : (i += 1) {
        const j = slice.len - 1 - i;
        const tmp = slice[i];
        slice[i] = slice[j];
        slice[j] = tmp;
    }
}

pub fn main() !void {
    var arr = [_]u8{ 'a', 'b', 'c', 'd', 'e' };
    reverse(&arr);
    std.debug.print("{s}\n", .{arr}); // prints "edcba"
}
```

### Example 2: Using Pointers for Out Parameters

```zig
const std = @import("std");

/// Splits a slice into two at the first occurrence of `sep`.
/// Returns true and sets `before` and `after` if found; otherwise returns false.
fn splitFirst(slice: []const u8, sep: u8, before: *[]const u8, after: *[]const u8) bool {
    for (slice, 0..) |c, i| {
        if (c == sep) {
            before.* = slice[0..i];
            after.* = slice[i+1..];
            return true;
        }
    }
    return false;
}

pub fn main() !void {
    const input = "hello,world";
    var first: []const u8 = undefined;
    var second: []const u8 = undefined;
    if (splitFirst(input, ',', &first, &second)) {
        std.debug.print("'{s}' and '{s}'\n", .{ first, second });
    }
}
```

### Example 3: Fixed‑Capacity Stack Using an Array

```zig
const std = @import("std");

fn Stack(comptime T: type, comptime capacity: usize) type {
    return struct {
        const Self = @This();
        data: [capacity]T = undefined,
        len: usize = 0,

        pub fn push(self: *Self, value: T) !void {
            if (self.len >= capacity) return error.Overflow;
            self.data[self.len] = value;
            self.len += 1;
        }

        pub fn pop(self: *Self) !T {
            if (self.len == 0) return error.Underflow;
            self.len -= 1;
            return self.data[self.len];
        }

        pub fn peek(self: *const Self) ?T {
            if (self.len == 0) return null;
            return self.data[self.len - 1];
        }

        pub fn slice(self: *const Self) []const T {
            return self.data[0..self.len];
        }
    };
}

pub fn main() !void {
    var stack = Stack(i32, 10){};
    try stack.push(100);
    try stack.push(200);
    std.debug.print("pop = {d}\n", .{try stack.pop()}); // 200
    std.debug.print("peek = {?d}\n", .{stack.peek()}); // 100
}
```

### Example 4: Arena‑Allocated Slice of Strings

```zig
const std = @import("std");

pub fn main() !void {
    var arena = std.heap.ArenaAllocator.init(std.heap.page_allocator);
    defer arena.deinit();
    const allocator = arena.allocator();

    // Allocate a slice of strings
    var strings = std.ArrayList([]const u8).init(allocator);
    defer strings.deinit();

    const names = [_][]const u8{ "Zig", "Rust", "C", "Go" };
    try strings.appendSlice(&names);

    // Append a dynamically constructed string
    const dynamic = try std.fmt.allocPrint(allocator, "v{d}", .{0});
    try strings.append(dynamic);

    for (strings.items) |s| {
        std.debug.print("{s}\n", .{s});
    }
}
```

All examples compile with `zig build-exe` or `zig test`. The arena allocator ensures all memory is freed at once.

