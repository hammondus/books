### 11.8 Examples

**Example 1: A 3D vector type with basic arithmetic**

This example shows a normal struct, a `const self` method, and an in‑place modifying method. It uses no allocations and can be compiled with `zig build-exe example1.zig`.

```zig
const std = @import("std");

const Vec3 = struct {
    x: f32,
    y: f32,
    z: f32,

    pub fn length(self: Vec3) f32 {
        return @sqrt(self.x * self.x + self.y * self.y + self.z * self.z);
    }

    pub fn normalized(self: Vec3) Vec3 {
        const inv_len = 1.0 / self.length();
        return Vec3{
            .x = self.x * inv_len,
            .y = self.y * inv_len,
            .z = self.z * inv_len,
        };
    }

    pub fn add(self: *Vec3, other: Vec3) void {
        self.x += other.x;
        self.y += other.y;
        self.z += other.z;
    }
};

pub fn main() !void {
    var a = Vec3{ .x = 1.0, .y = 0.0, .z = 0.0 };
    const b = Vec3{ .x = 0.0, .y = 1.0, .z = 0.0 };
    a.add(b);
    std.debug.print("a = ({d:.1}, {d:.1}, {d:.1})\n", .{ a.x, a.y, a.z });
    // Output: a = (1.0, 1.0, 0.0)
}
```

**Example 2: Packed struct for a 32‑bit colour with bitfields**

This demonstrates reading and writing individual colour components while the whole value fits in a `u32`. Useful for framebuffers or serialisation.

```zig
const std = @import("std");

const Color = packed struct(u32) {
    r: u8,  // bits 0..7
    g: u8,  // bits 8..15
    b: u8,  // bits 16..23
    a: u8,  // bits 24..31
};

pub fn main() void {
    var c = Color{ .r = 0xFF, .g = 0x80, .b = 0x40, .a = 0x00 };
    const raw = @as(u32, @bitCast(c));
    std.debug.print("raw = 0x{X:0>8}\n", .{raw}); // little-endian: 0x004080FF

    // Modify the red component
    c.r = 0x10;
    std.debug.print("red = {}\n", .{c.r}); // 16
}
```

**Example 3: Extern struct for C interop (POSIX timespec)**

This shows how to match C’s `struct timespec` and call a C function (here we simulate with a Zig function that expects the same layout).

```zig
const std = @import("std");

const Timespec = extern struct {
    tv_sec: i64,
    tv_nsec: i64,
};

// Simulate a C function that expects a timespec pointer
extern fn clock_gettime(clk_id: i32, tp: *Timespec) i32;

// Provide a dummy implementation when not linking libc
fn clock_gettime_dummy(_: i32, tp: *Timespec) i32 {
    tp.* = Timespec{ .tv_sec = 123456, .tv_nsec = 789 };
    return 0;
}
const clock_gettime = if (@import("builtin").link_libc) clock_gettime else clock_gettime_dummy;

pub fn main() !void {
    var ts: Timespec = undefined;
    _ = clock_gettime(0, &ts);
    std.debug.print("sec={}, nsec={}\n", .{ ts.tv_sec, ts.tv_nsec });
}
```

Compile with `zig build-exe example3.zig -lc` to use the real `clock_gettime` (on POSIX systems).

