## 8. Examples

### Example 1: Basic Stack vs. Heap Comparison

```zig
const std = @import("std");

pub fn main() !void {
    // Stack: fixed array of 4 integers
    var stack_arr: [4]u32 = .{ 10, 20, 30, 40 };
    std.debug.print("stack_arr at {*}\n", .{&stack_arr});

    // Heap: dynamic array with length known at runtime
    const n = 4;
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const alloc = gpa.allocator();

    const heap_arr = try alloc.alloc(u32, n);
    defer alloc.free(heap_arr);
    @memcpy(heap_arr, &stack_arr);
    std.debug.print("heap_arr at {*}\n", .{heap_arr.ptr});
}
```

### Example 2: Using `FixedBufferAllocator` as a Stack‑Backed Allocator

```zig
const std = @import("std");

pub fn main() !void {
    var stack_memory: [512]u8 align(8) = undefined;
    var fba = std.heap.FixedBufferAllocator.init(&stack_memory);
    const bump = fba.allocator();

    const a = try bump.create(u32);
    a.* = 100;
    const b = try bump.alloc(u8, 100);
    for (b, 0..) |*byte, i| byte.* = @intCast(i);

    std.debug.print("a = {} at {*}\n", .{ a.*, a });
    std.debug.print("b[0] = {d} at {*}\n", .{ b[0], b.ptr });

    // No need to free a and b individually; the reset will discard them.
    fba.reset();

    // After reset, we can reuse the same memory.
    const c = try bump.create(u64);
    c.* = 0xDEADBEEF;
    std.debug.print("c = {x} at {*}\n", .{ c.*, c });
}
```

### Example 3: Alloc‑Free Integer to String Conversion

```zig
const std = @import("std");

/// Converts a 32‑bit integer to a decimal string. The output is written into `out_buf`
/// and the function returns a slice of `out_buf` that contains the result.
/// If `out_buf` is too small, `error.NoSpaceLeft` is returned.
fn intToStr(value: i32, out_buf: []u8) ![]u8 {
    // `std.fmt.bufPrint` writes into the provided buffer and returns a slice.
    return std.fmt.bufPrint(out_buf, "{}", .{value});
}

pub fn main() !void {
    var stack_buf: [16]u8 = undefined; // Enough for any 32‑bit decimal number.
    const result = try intToStr(-12345, &stack_buf);
    std.debug.assert(std.mem.eql(u8, result, "-12345"));
    std.debug.print("Result: {s}\n", .{result});

    // Demonstrate error when buffer is too small.
    var tiny_buf: [3]u8 = undefined;
    _ = intToStr(1000, &tiny_buf) catch |err| {
        std.debug.print("Expected error: {}\n", .{err}); // error.NoSpaceLeft
    };
}
```

### Example 4: Real‑Time Constrained Ring Buffer with Preallocated Storage

```zig
const std = @import("std");

// Fixed‑capacity ring buffer designed for real‑time audio or sensor data.
// No heap allocations after initialization.
pub fn RingBuffer(comptime T: type, comptime capacity: usize) type {
    return struct {
        buffer: [capacity]T = undefined,
        read_index: usize = 0,
        write_index: usize = 0,
        count: usize = 0,

        const Self = @This();

        pub fn push(self: *Self, value: T) !void {
            if (self.count == capacity) return error.Full;
            self.buffer[self.write_index] = value;
            self.write_index = (self.write_index + 1) % capacity;
            self.count += 1;
        }

        pub fn pop(self: *Self) !T {
            if (self.count == 0) return error.Empty;
            const value = self.buffer[self.read_index];
            self.read_index = (self.read_index + 1) % capacity;
            self.count -= 1;
            return value;
        }

        pub fn isFull(self: *const Self) bool { return self.count == capacity; }
        pub fn isEmpty(self: *const Self) bool { return self.count == 0; }
    };
}

pub fn main() !void {
    // All stack memory – guarantees no dynamic allocation.
    var ring = RingBuffer(u16, 1024){};

    try ring.push(42);
    try ring.push(100);

    const val = try ring.pop();
    std.debug.print("Popped: {}\n", .{val});
    std.debug.print("Remaining count: {}\n", .{ring.count});
}
```

