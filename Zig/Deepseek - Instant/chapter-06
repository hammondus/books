### 8. Examples

#### Example 1: Command-line argument parser with control flow

This program demonstrates `if` capture, `while` loop with optional, `switch`, and labeled block.

```zig
const std = @import("std");

pub fn main() !void {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const args = try std.process.argsAlloc(allocator);
    defer std.process.argsFree(allocator, args);

    if (args.len < 2) {
        std.debug.print("Usage: {s} [--verbose] [--output <file>] <input>\n", .{args[0]});
        return error.InvalidArguments;
    }

    var verbose = false;
    var output_file: ?[]const u8 = null;
    var input_file: ?[]const u8 = null;
    var i: usize = 1;
    while (i < args.len) : (i += 1) {
        const arg = args[i];
        if (std.mem.eql(u8, arg, "--verbose")) {
            verbose = true;
        } else if (std.mem.eql(u8, arg, "--output")) {
            i += 1;
            if (i >= args.len) return error.MissingOutputPath;
            output_file = args[i];
        } else {
            // assume it's the input file
            if (input_file != null) return error.TooManyInputs;
            input_file = arg;
        }
    }
    const input = input_file orelse return error.MissingInput;

    const result = process: {
        if (verbose) std.debug.print("Processing {s}...\n", .{input});
        if (output_file) |out| {
            std.debug.print("Output to {s}\n", .{out});
        }
        break :process true;
    };
    _ = result;
}
```

#### Example 2: State machine using `switch` on a tagged union

```zig
const std = @import("std");

const State = union(enum) {
    idle,
    reading: u32,      // bytes read so far
    done: []const u8,  // result
    error: anyerror,
};

pub fn run(allocator: std.mem.Allocator) void {
    var state = State.idle;
    var result_buf: [100]u8 = undefined;

    // Simulate a sequence of events
    const events = [_]State{
        .idle,
        .{ .reading = 0 },
        .{ .reading = 42 },
        .{ .done = "success" },
    };

    for (events) |event| {
        state = switch (state) {
            .idle => switch (event) {
                .reading => event,
                else => .{ .error = error.InvalidTransition },
            },
            .reading => |bytes| switch (event) {
                .reading => |new_bytes| .{ .reading = bytes + new_bytes },
                .done => |result| blk: {
                    const final_result = try std.fmt.bufPrint(&result_buf, "Read {} bytes: {s}", .{ bytes, result });
                    break :blk .{ .done = final_result };
                },
                else => .{ .error = error.InvalidTransition },
            },
            .done => |result| {
                std.debug.print("Final result: {s}\n", .{result});
                return;
            },
            .error => |err| {
                std.debug.print("Error: {}\n", .{err});
                return;
            },
        };
    }
}

pub fn main() void {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    run(gpa.allocator());
}
```

#### Example 3: Comptime‑eliminated debugging

```zig
const std = @import("std");

const LogLevel = enum { debug, info, warn, err };
const current_log_level = LogLevel.info;  // change this at compile time

pub fn log(comptime level: LogLevel, comptime fmt: []const u8, args: anytype) void {
    if (@intFromEnum(level) >= @intFromEnum(current_log_level)) {
        std.debug.print(fmt, args);
    }
}

pub fn main() void {
    // These calls become no-ops when current_log_level is higher than debug
    log(.debug, "debug: x = {d}\n", .{42});
    log(.info, "info: program started\n", .{});
    // The condition is evaluated at compile time, so no runtime branch exists.
}
```

Compile with `zig build-exe` and inspect the generated machine code – you’ll see the `log(.debug, ...)` call is entirely absent when `current_log_level` is `.info` or higher.

