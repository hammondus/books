## 16.8 Examples

### Example 1: Multi‑Resource Acquisition with Cleanup

```zig
const std = @import("std");

pub fn main() !void {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    // Acquire two files and a buffer
    const in = try std.fs.cwd().openFile("input.txt", .{});
    defer in.close();

    const out = try std.fs.cwd().createFile("output.txt", .{});
    defer out.close();

    const buf = try allocator.alloc(u8, 4096);
    defer allocator.free(buf);

    // Copy data
    while (true) {
        const bytes_read = try in.read(buf);
        if (bytes_read == 0) break;
        try out.writeAll(buf[0..bytes_read]);
    }
}
```

Compile and run: `zig build-exe example1.zig && ./example1`

### Example 2: Transactional File Write with Rollback

```zig
const std = @import("std");

fn safeWrite(allocator: std.mem.Allocator, path: []const u8, content: []const u8) !void {
    const tmp_path = try std.fmt.allocPrint(allocator, "{s}.tmp", .{path});
    defer allocator.free(tmp_path);

    const file = try std.fs.cwd().createFile(tmp_path, .{});
    defer file.close();

    // If any error occurs after this point, delete the temporary file
    errdefer std.fs.cwd().deleteFile(tmp_path) catch {};

    try file.writeAll(content);
    try file.sync(); // ensure data is durable
    try std.fs.cwd().rename(tmp_path, path);
}

pub fn main() !void {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    try safeWrite(allocator, "data.txt", "Hello, transactional write!");
    std.debug.print("Write succeeded\n", .{});
}
```

### Example 3: Custom Cleanup with a Deferred Struct Method

```zig
const std = @import("std");

const MyResource = struct {
    data: []u8,
    allocator: std.mem.Allocator,

    fn init(allocator: std.mem.Allocator, size: usize) !MyResource {
        const data = try allocator.alloc(u8, size);
        return MyResource{ .data = data, .allocator = allocator };
    }

    fn deinit(self: *MyResource) void {
        self.allocator.free(self.data);
        self.data = &[_]u8{};
    }

    fn write(self: *MyResource, bytes: []const u8) !void {
        if (bytes.len > self.data.len) return error.OutOfSpace;
        @memcpy(self.data[0..bytes.len], bytes);
    }
};

pub fn main() !void {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    var res = try MyResource.init(allocator, 1024);
    defer res.deinit(); // custom cleanup

    try res.write("Hello, custom defer!");
    std.debug.print("Data: {s}\n", .{res.data[0.."Hello, custom defer!".len]});
}
```

### Example 4: Mutex Lock/Unlock with Defer

```zig
const std = @import("std");

var shared_counter: u32 = 0;
var mutex: std.Thread.Mutex = .{};

fn increment(thread_id: u32) void {
    mutex.lock();
    defer mutex.unlock(); // guarantee unlock even if panics? (panic aborts, but still)
    shared_counter += 1;
    std.debug.print("Thread {} incremented to {}\n", .{ thread_id, shared_counter });
}

pub fn main() !void {
    var threads: [10]std.Thread = undefined;
    for (&threads, 0..) |*t, i| {
        t.* = try std.Thread.spawn(.{}, increment, .{@as(u32, @intCast(i))});
    }
    for (threads) |t| {
        t.join();
    }
    std.debug.print("Final counter: {}\n", .{shared_counter});
}
```

