### 8. Examples

#### Example 1: Build Modes in `build.zig`

```zig
const std = @import("std");

pub fn build(b: *std.Build) void {
    const target = b.standardTargetOptions(.{});
    const optimize = b.standardOptimizeOption(.{});

    const exe = b.addExecutable(.{
        .name = "safety_demo",
        .root_source_file = b.path("src/main.zig"),
        .target = target,
        .optimize = optimize,
    });

    // Ensure we can pass custom log level at compile time
    exe.root_module.addCMacro("LOG_LEVEL", b.option([]const u8, "log-level", "Log level") orelse "info");

    b.installArtifact(exe);
}
```

#### Example 2: Safety Panic Demonstration

```zig
const std = @import("std");

pub fn main() !void {
    var slice = try std.heap.page_allocator.alloc(u8, 10);
    defer std.heap.page_allocator.free(slice);

    // Safety check triggers: index 10 >= len 10
    slice[10] = 42;
}
```
Compile with `-ODebug` → panic with trace. Compile with `-OReleaseFast` → undefined behavior (possible memory corruption).

#### Example 3: Using `std.log` with Scopes and Runtime Filtering

```zig
const std = @import("std");

const log_network = std.log.scoped(.network);
const log_parser = std.log.scoped(.parser);

pub fn main() void {
    // These appear only if log level allows (default = info)
    log_network.info("listening on port {}", .{8080});
    log_parser.debug("token: {s}", .{"EOF"});  // not shown by default

    // Override log level at compile time with -Dlog-level=debug
}
```

#### Example 4: Strategic `@setRuntimeSafety`

```zig
const std = @import("std");

/// Assumes both slices are same length and caller guarantees no overlap.
fn add_vectors(a: []f32, b: []f32, out: []f32) void {
    std.debug.assert(a.len == b.len and a.len == out.len);

    // After assertion, we know lengths are equal and valid
    @setRuntimeSafety(false, .{
        for (0..a.len) |i| {
            out[i] = a[i] + b[i];
        }
    });
}

pub fn main() !void {
    var a = [_]f32{ 1, 2, 3 };
    var b = [_]f32{ 4, 5, 6 };
    var out: [3]f32 = undefined;
    add_vectors(&a, &b, &out);
    std.debug.print("{any}\n", .{out});
}
```

#### Example 5: Debugging with GDB

Compile with debug symbols:
```bash
zig build-exe main.zig -ODebug
gdb ./main
(gdb) break main
(gdb) run
(gdb) print variable
(gdb) continue
```

Because Zig emits standard DWARF, GDB and LLDB work seamlessly. Use `zig build-exe -fno-emit-bin -femit-asm` to inspect the generated assembly and see where safety checks are inserted.

