## 8. Examples

### Example 1: Type-Safe Enum String Conversion

Generate `toString` and `fromString` methods for any enum without runtime tables or separate tooling:

```zig
const std = @import("std");

fn EnumHelpers(comptime E: type) type {
    const info = @typeInfo(E);
    if (info != .enum_) {
        @compileError("Expected enum type, got " ++ @typeName(E));
    }

    const fields = info.enum_.fields;

    return struct {
        pub fn toString(value: E) []const u8 {
            inline for (fields) |field| {
                if (value == @field(E, field.name)) {
                    return field.name;
                }
            }
            unreachable;
        }

        pub fn fromString(str: []const u8) !E {
            inline for (fields) |field| {
                if (std.mem.eql(u8, str, field.name)) {
                    return @field(E, field.name);
                }
            }
            return error.InvalidEnumValue;
        }
    };
}

const Color = enum { Red, Green, Blue };
const ColorHelpers = EnumHelpers(Color);

pub fn main() !void {
    const color = Color.Green;
    std.debug.print("Color: {s}\n", .{ColorHelpers.toString(color)});

    const parsed = try ColorHelpers.fromString("Blue");
    std.debug.print("Parsed: {any}\n", .{parsed});
}
```

### Example 2: Compile-Time Regular Expression Compilation (Conceptual)

```zig
const std = @import("std");

// Simplified matcher that compiles regex to a state machine at comptime
fn Regex(comptime pattern: []const u8) type {
    // Parse pattern at compile time
    comptime var states: [256]State = undefined;
    comptime var state_count: usize = 0;

    // ... state machine construction logic ...

    return struct {
        pub fn matches(input: []const u8) bool {
            // Execute compiled state machine at runtime
            var current_state: usize = 0;
            for (input) |c| {
                current_state = transition(current_state, c);
                if (current_state == dead_state) return false;
            }
            return is_accepting(current_state);
        }

        fn transition(state: usize, c: u8) usize {
            // Use comptime-generated table
            return transition_table[state][c];
        }

        const transition_table = comptime generate_table();
    };
}

const DigitRegex = Regex("^[0-9]+$");
pub fn main() void {
    std.debug.print("12345 matches? {}\n", .{DigitRegex.matches("12345")});
    std.debug.print("12a45 matches? {}\n", .{DigitRegex.matches("12a45")});
}
```

### Example 3: Comptime-Dimensional Analysis

```zig
const std = @import("std");

fn Dimensional(comptime mass_exp: i8, comptime length_exp: i8, comptime time_exp: i8) type {
    // Store exponents as comptime-known values in the type
    return struct {
        const M = mass_exp;
        const L = length_exp;
        const T = time_exp;
        value: f64,

        pub fn add(self: @This(), other: @This()) @This() {
            return .{ .value = self.value + other.value };
        }

        pub fn multiply(comptime Other: type, self: @This(), other: Other) Dimensional(
            mass_exp + Other.M,
            length_exp + Other.L,
            time_exp + Other.T,
        ) {
            return .{ .value = self.value * other.value };
        }

        pub fn format(self: @This(), comptime fmt: []const u8, options: std.fmt.FormatOptions, writer: anytype) !void {
            _ = fmt;
            _ = options;
            try writer.print("{d} kg^{d} m^{d} s^{d}", .{
                self.value, mass_exp, length_exp, time_exp
            });
        }
    };
}

const Mass = Dimensional(1, 0, 0);
const Length = Dimensional(0, 1, 0);
const Time = Dimensional(0, 0, 1);
const Velocity = Dimensional(0, 1, -1);
const Acceleration = Dimensional(0, 1, -2);
const Force = Dimensional(1, 1, -2);

pub fn main() void {
    const m = Mass{ .value = 10.0 };
    const a = Acceleration{ .value = 9.8 };
    const f = m.multiply(Acceleration, m, a);

    std.debug.print("Force: {}\n", .{f});  // 98.0 kg^1 m^1 s^-2
}
```

