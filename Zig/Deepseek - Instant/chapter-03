## 3.8 Examples

### Example 1: Minimal HTTP Client (Using the Standard Library)

```zig
const std = @import("std");

pub fn main() !void {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    var client = std.http.Client{ .allocator = allocator };
    defer client.deinit();

    const uri = try std.Uri.parse("https://ziglang.org/");
    var req = try client.open(.GET, uri, .{});
    defer req.deinit();

    try req.send(.{});
    try req.wait();

    const stdout = std.io.getStdOut().writer();
    const reader = req.reader();
    var buf: [4096]u8 = undefined;
    while (try reader.read(&buf)) |chunk| {
        try stdout.writeAll(chunk);
    }
}
```

**Compile:** `zig build-exe client.zig -lc` (needs libc for TLS).

### Example 2: Reading a File Line by Line

```zig
const std = @import("std");

pub fn main() !void {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const args = try std.process.argsAlloc(allocator);
    defer std.process.argsFree(allocator, args);

    if (args.len < 2) {
        std.log.err("Usage: {s} <filename>", .{args[0]});
        std.process.exit(1);
    }

    const file = try std.fs.cwd().openFile(args[1], .{});
    defer file.close();

    const stdout = std.io.getStdOut().writer();
    var buf_reader = std.io.bufferedReader(file.reader());
    const reader = buf_reader.reader();

    var line_buf: [4096]u8 = undefined;
    while (try reader.readUntilDelimiterOrEof(&line_buf, '\n')) |line| {
        try stdout.print("{s}\n", .{line});
    }
}
```

**Demonstrates:**
- Command‑line argument validation.
- File I/O with explicit `open`/`close`.
- `defer` for resource cleanup.
- Buffered reading for efficiency.

### Example 3: Unit Tests Inside the Same File

```zig
const std = @import("std");

pub fn main() !void {
    // Program entry – can be empty for a test harness
}

fn add(a: i32, b: i32) i32 {
    return a + b;
}

test "add works" {
    try std.testing.expect(add(2, 2) == 4);
    try std.testing.expect(add(-5, 3) == -2);
}

test "allocator test" {
    var arena = std.heap.ArenaAllocator.init(std.heap.page_allocator);
    defer arena.deinit();
    const allocator = arena.allocator();

    const slice = try allocator.alloc(u8, 100);
    defer allocator.free(slice); // not strictly needed due to arena, but shows pattern

    slice[0] = 42;
    try std.testing.expect(slice[0] == 42);
}
```

Run tests with: `zig test main.zig`

