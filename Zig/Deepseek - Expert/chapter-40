## 8. Examples

### Complete Blinky for STM32F4 (Cortex‑M4)

**link.ld** (excerpt):
```ld
MEMORY
{
    FLASH (rx) : ORIGIN = 0x08000000, LENGTH = 512K
    RAM   (rwx): ORIGIN = 0x20000000, LENGTH = 128K
}

_estack = ORIGIN(RAM) + LENGTH(RAM);

SECTIONS
{
    .vector_table : { KEEP(*(.vector_table)) } > FLASH
    .text : { *(.text*) } > FLASH
    .rodata : { *(.rodata*) } > FLASH
    .data : {
        __data_load = LOADADDR(.data);
        __data_start = .;
        *(.data*)
        __data_end = .;
    } > RAM AT > FLASH
    .bss : {
        __bss_start = .;
        *(.bss*)
        __bss_end = .;
    } > RAM
}
```

**src/main.zig**:
```zig
const std = @import("std");
const builtin = @import("builtin");

// ---------- std_options (panic handler) ----------
pub const std_options = struct {
    pub fn panic(msg: []const u8, _: ?*std.builtin.StackTrace, _: ?usize) noreturn {
        // In a real system, log msg to UART or blink an LED.
        while (true) {}
    }
};

// ---------- Vector table ----------
const vector_table linksection(".vector_table") = [_]?*const fn () callconv(.C) void{
    @ptrCast(&_estack),
    _start,
    default_handler, // NMI
    default_handler, // HardFault
    default_handler, // MemManage
    default_handler, // BusFault
    default_handler, // UsageFault
    null, null, null, null, // reserved
    default_handler, // SVCall
    default_handler, // DebugMon
    null,             // reserved
    default_handler, // PendSV
    SysTick_Handler, // SysTick
};

// ---------- Symbols from linker script ----------
extern const _estack: u32;
extern var __data_load: u8;
extern var __data_start: u8;
extern var __data_end: u8;
extern var __bss_start: u8;
extern var __bss_end: u8;

fn default_handler() callconv(.C) void {
    while (true) {}
}

// ---------- Reset handler ----------
export fn _start() callconv(.Naked) noreturn {
    // Set stack pointer
    asm volatile (
        \\   ldr sp, =_estack
        \\   bl  zig_main
    );
    unreachable;
}

fn zig_main() noreturn {
    // Initialize .data and .bss
    const data_load_addr: [*]const u8 = @ptrCast(&__data_load);
    const data_start_addr: [*]u8 = @ptrCast(&__data_start);
    const data_size = @intFromPtr(&__data_end) - @intFromPtr(&__data_start);
    @memcpy(data_start_addr[0..data_size], data_load_addr[0..data_size]);

    const bss_start: [*]u8 = @ptrCast(&__bss_start);
    const bss_size = @intFromPtr(&__bss_end) - @intFromPtr(&__bss_start);
    @memset(bss_start[0..bss_size], 0);

    // Enable clocks for GPIOA (RCC_AHB1ENR, bit 0)
    const RCC_AHB1ENR = @as(*volatile u32, @ptrFromInt(0x40023830));
    RCC_AHB1ENR.* |= 1;

    // Configure PA5 as output (GPIOA_MODER, bits 10‑11 = 01)
    const GPIOA_MODER = @as(*volatile u32, @ptrFromInt(0x40020000));
    GPIOA_MODER.* &= ~(@as(u32, 3) << 10); // clear
    GPIOA_MODER.* |= (1 << 10);             // set as output

    // Configure SysTick for 1 ms interrupts (optional blink timer)
    const SYST_RVR = @as(*volatile u32, @ptrFromInt(0xE000E014));
    const SYST_CSR = @as(*volatile u32, @ptrFromInt(0xE000E010));
    const SYST_CVR = @as(*volatile u32, @ptrFromInt(0xE000E018));
    SYST_RVR.* = 16000 - 1; // assuming 16 MHz clock
    SYST_CVR.* = 0;
    SYST_CSR.* = 0b111; // enable, tickint, clksource

    // Simple LED toggle in a loop (also toggled in SysTick)
    var led_state: u32 = 0;
    while (true) {
        // Wait for SysTick flag
        while (systick_tick == 0) {}
        systick_tick = 0;
        led_state ^= 1;
        if (led_state != 0) {
            GPIOA_BSRR.* = (1 << 5); // set PA5
        } else {
            GPIOA_BSRR.* = (1 << (5 + 16)); // reset PA5
        }
    }
}

var systick_tick: volatile u32 = 0;

const GPIOA_BSRR = @as(*volatile u32, @ptrFromInt(0x40020018));

export fn SysTick_Handler() callconv(.Interrupt) void {
    systick_tick = 1;
}
```

**Build and flash**:
```bash
zig build
```

This example covers all fundamentals: linker script, vector table, manual startup, clock enable, GPIO output, SysTick interrupt with correct calling convention, and volatile access. It compiles to a few hundred bytes of flash.

