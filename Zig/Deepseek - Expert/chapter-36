## 8. Examples

Here is a complete, buildable example that demonstrates all four anti‑patterns and their corrections side‑by‑side. You can compile it with `zig build-exe`.

```zig
const std = @import("std");

// ─────────────────────────────────────────────────
// Anti-pattern 1: OOP with vtables
// ─────────────────────────────────────────────────
const ShapeVtable = struct {
    area: *const fn (ptr: *anyopaque) f64,
};

const VtableShape = struct {
    ptr: *anyopaque,
    vtable: *const ShapeVtable,
    pub fn area(self: VtableShape) f64 {
        return self.vtable.area(self.ptr);
    }
};

const VCircle = struct {
    radius: f64,
    fn area(ptr: *anyopaque) f64 {
        const self = @as(*VCircle, @ptrCast(@alignCast(ptr)));
        return std.math.pi * self.radius * self.radius;
    }
};

// ─────────────────────────────────────────────────
// Idiomatic: Tagged union
// ─────────────────────────────────────────────────
const Shape = union(enum) {
    circle: Circle,
    rectangle: Rectangle,

    pub const Circle = struct { radius: f64 };
    pub const Rectangle = struct { width: f64, height: f64 };

    pub fn area(self: Shape) f64 {
        return switch (self) {
            .circle => |c| std.math.pi * c.radius * c.radius,
            .rectangle => |r| r.width * r.height,
        };
    }
};

// ─────────────────────────────────────────────────
// Anti-pattern 2: Over‑abstracted interface
// ─────────────────────────────────────────────────
const Output = struct {
    ptr: *anyopaque,
    writeFn: *const fn (ptr: *anyopaque, bytes: []const u8) anyerror!void,

    pub fn write(self: Output, bytes: []const u8) !void {
        return self.writeFn(self.ptr, bytes);
    }
};

// ─────────────────────────────────────────────────
// Idiomatic: Accept anytype writer
// ─────────────────────────────────────────────────
fn printArea(writer: anytype, shape: Shape) !void {
    try writer.print("area = {d}\n", .{shape.area()});
}

// ─────────────────────────────────────────────────
// Anti-pattern 3: catch unreachable on a real error
// ─────────────────────────────────────────────────
fn parseIntCrutch(s: []const u8) u32 {
    return std.fmt.parseInt(u32, s, 10) catch unreachable;
}

// ─────────────────────────────────────────────────
// Idiomatic: explicit handling
fn parseIntSafe(s: []const u8) !u32 {
    return try std.fmt.parseInt(u32, s, 10);
}

// ─────────────────────────────────────────────────
// Anti-pattern 4: Premature packed
// ─────────────────────────────────────────────────
const PackedPoint = packed struct {
    x: u32,
    y: u32,
};

// ─────────────────────────────────────────────────
// Idiomatic: natural alignment
const Point = struct {
    x: u32,
    y: u32,
};

pub fn main() !void {
    const stdout = std.io.getStdOut().writer();

    // Vtable usage (anti-pattern)
    const vcircle = VCircle{ .radius = 3.0 };
    var vshape = VtableShape{
        .ptr = @constCast(&vcircle),
        .vtable = &.{ .area = VCircle.area },
    };
    try stdout.print("vtable area = {d}\n", .{vshape.area()});

    // Tagged union (idiomatic)
    const shape = Shape{ .circle = .{ .radius = 3.0 } };
    try printArea(stdout, shape);

    // catch unreachable (anti-pattern)
    const bad = parseIntCrutch("42");
    try stdout.print("bad: {d}\n", .{bad});

    // Proper error handling (idiomatic)
    const good = parseIntSafe("42") catch |err| {
        std.log.err("parse failed: {}", .{err});
        return err;
    };
    try stdout.print("good: {d}\n", .{good});

    // Packed vs natural
    const pp = PackedPoint{ .x = 1, .y = 2 };
    const p = Point{ .x = 1, .y = 2 };
    _ = pp; _ = p;
}
```

The idiomatic sections of this example can be compiled and run without any allocations or hidden control flow. Notice that the tagged‑union version of `area` is trivially inlinable, while the vtable version forces an indirect call. The `printArea` function accepts any writer type, demonstrating how comptime genericity replaces interface abstractions. The integer parsing calls show that the error is either propagated or handled, never silently discarded.

