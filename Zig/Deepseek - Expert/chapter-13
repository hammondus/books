## 8. Examples

### Example 1: Stack‑Allocated String Concatenation with Separator

Build a comma‑separated list from an array of strings, using only a stack buffer.

```zig
const std = @import("std");

fn joinStrings(
    parts: []const []const u8,
    sep: []const u8,
    buf: []u8,
) ![]const u8 {
    var stream = std.io.fixedBufferStream(buf);
    const writer = stream.writer();
    for (parts, 0..) |part, i| {
        if (i > 0) {
            _ = try writer.write(sep);
        }
        _ = try writer.write(part);
    }
    return stream.getWritten();
}

test "join strings on stack" {
    const words = &[_][]const u8{ "Hello", "World", "Zig" };
    var buf: [64]u8 = undefined;
    const result = try joinStrings(words, ", ", &buf);
    try std.testing.expectEqualStrings("Hello, World, Zig", result);
}
```

The function returns a `[]const u8` slice into `buf`. No dynamic allocation. Note that the buffer is not null‑terminated unless you ensure a zero byte after the written portion.

### Example 2: UTF‑8 Codepoint Iterator and Validation

Count the number of Unicode codepoints in a string, rejecting invalid UTF‑8.

```zig
const std = @import("std");

fn countCodepoints(text: []const u8) !usize {
    var view = try std.unicode.Utf8View.init(text);
    var iter = view.iterator();
    var count: usize = 0;
    while (iter.nextCodepoint()) |_| {
        count += 1;
    }
    return count;
}

test "count codepoints" {
    const s = "Zig 🦎";
    const n = try countCodepoints(s);
    // 'Zig ' + lizard emoji -> 4 letters + 1 space + 1 emoji = 6?
    // Actually "Zig " is 4 chars (Z,i,g,space) and the emoji is 1 codepoint.
    try std.testing.expectEqual(@as(usize, 5), n);
}
```

### Example 3: Simple String Interner with C‑compatible Null Terminator

A basic interner that stores strings in an arena and allows lookup by value. It returns `[:0]const u8` ready for C.

```zig
const std = @import("std");

const Interner = struct {
    arena: std.heap.ArenaAllocator,
    map: std.StringHashMap([:0]const u8),

    pub fn init(backing_allocator: std.mem.Allocator) Interner {
        return .{
            .arena = std.heap.ArenaAllocator.init(backing_allocator),
            .map = std.StringHashMap([:0]const u8).init(backing_allocator),
        };
    }

    pub fn deinit(self: *Interner) void {
        // arena deinit frees all strings
        self.arena.deinit();
        self.map.deinit();
    }

    pub fn intern(self: *Interner, s: []const u8) ![:0]const u8 {
        const gop = try self.map.getOrPut(s);
        if (gop.found_existing) return gop.value_ptr.*;

        // allocate in arena with extra byte for null
        const alloc = self.arena.allocator();
        const new_str = try alloc.alloc(u8, s.len + 1);
        @memcpy(new_str[0..s.len], s);
        new_str[s.len] = 0; // sentinel

        const result: [:0]const u8 = new_str[0..s.len :0];
        gop.value_ptr.* = result;
        return result;
    }
};

test "intern strings" {
    var interner = Interner.init(std.testing.allocator);
    defer interner.deinit();

    const a = try interner.intern("hello");
    const b = try interner.intern("hello");
    const c = try interner.intern("world");

    try std.testing.expectEqual(a.ptr, b.ptr); // same pointer
    try std.testing.expect(a.ptr != c.ptr);
    try std.testing.expectEqualStrings("hello", a);
    // a is [:0]const u8, so it can be passed to C:
    // std.c.puts(a.ptr);
}
```

### Example 4: Using `bufPrintZ` to Format a Message with Null Terminator

```zig
const std = @import("std");

fn formatError(code: u16, buf: []u8) ![:0]const u8 {
    return std.fmt.bufPrintZ(buf, "Error {d}: {s}", .{
        code,
        if (code == 404) "Not Found" else "Unknown",
    });
}

test "bufPrintZ null termination" {
    var buf: [128]u8 = undefined;
    const msg = try formatError(404, &buf);
    try std.testing.expect(msg.len == 18); // "Error 404: Not Found"
    try std.testing.expect(msg[msg.len] == 0); // sentinel present
}
```

