### 8. Examples

**Example 1: A `Vec3` struct with vector operations, leveraging anonymous literals for construction, and a test that verifies behavior.**

```zig
const std = @import("std");
const expect = std.testing.expect;

const Vec3 = struct {
    x: f32,
    y: f32,
    z: f32,

    pub fn init(x: f32, y: f32, z: f32) Vec3 {
        return .{ .x = x, .y = y, .z = z };
    }

    pub fn zero() Vec3 {
        return .{ .x = 0, .y = 0, .z = 0 };
    }

    pub fn dot(self: Vec3, other: Vec3) f32 {
        return self.x * other.x + self.y * other.y + self.z * other.z;
    }

    pub fn scale(self: *Vec3, factor: f32) void {
        self.x *= factor;
        self.y *= factor;
        self.z *= factor;
    }
};

test "Vec3 operations" {
    var v = Vec3.init(1, 2, 3);
    v.scale(2);
    try expect(v.x == 2 and v.y == 4 and v.z == 6);
    const d = v.dot(Vec3.init(1, 0, 0));
    try expect(d == 2);
}
```

**Example 2: A generic pool allocator using a comptime‑generated struct, demonstrating complete memory management with `Allocator`.**

```zig
const std = @import("std");
const Allocator = std.mem.Allocator;

fn ObjectPool(comptime T: type) type {
    return struct {
        available: std.ArrayList(*T),
        allocator: Allocator,

        const Self = @This();

        pub fn init(allocator: Allocator) Self {
            return .{
                .available = std.ArrayList(*T).init(allocator),
                .allocator = allocator,
            };
        }

        pub fn deinit(self: *Self) void {
            for (self.available.items) |item| {
                self.allocator.destroy(item);
            }
            self.available.deinit();
        }

        pub fn acquire(self: *Self) !*T {
            if (self.available.popOrNull()) |item| {
                return item;
            }
            const new = try self.allocator.create(T);
            new.* = undefined; // caller must initialize
            return new;
        }

        pub fn release(self: *Self, item: *T) !void {
            try self.available.append(item);
        }
    };
}

test "ObjectPool basic usage" {
    const Pool = ObjectPool(u32);
    var pool = Pool.init(std.testing.allocator);
    defer pool.deinit();

    const a = try pool.acquire();
    a.* = 42;
    const b = try pool.acquire();
    b.* = 7;

    try pool.release(a);
    const reused = try pool.acquire();
    try std.testing.expect(reused == a);
    try std.testing.expectEqual(@as(u32, 42), reused.*);
}
```

**Example 3: Embedded struct and `@fieldParentPtr` for an extensible widget pattern.**

```zig
const std = @import("std");

const Widget = struct {
    x: i32,
    y: i32,
    pub fn moveTo(self: *Widget, new_x: i32, new_y: i32) void {
        self.x = new_x;
        self.y = new_y;
    }
};

const Button = struct {
    widget: Widget,
    label: []const u8,

    pub fn init(x: i32, y: i32, label: []const u8) Button {
        return .{
            .widget = .{ .x = x, .y = y },
            .label = label,
        };
    }

    pub fn asWidget(self: *Button) *Widget {
        return &self.widget;
    }

    pub fn click(self: *Button) void {
        std.debug.print("Button '{s}' clicked at ({d},{d})\n", .{ self.label, self.widget.x, self.widget.y });
    }
};

test "Button as Widget" {
    var btn = Button.init(10, 20, "OK");
    const w = btn.asWidget();
    w.moveTo(30, 40);
    try std.testing.expectEqual(@as(i32, 30), btn.widget.x);
    try std.testing.expectEqual(@as(i32, 40), btn.widget.y);

    // Recover button from widget pointer using @fieldParentPtr
    const recovered: *Button = @fieldParentPtr("widget", w);
    try std.testing.expect(recovered == &btn);
}
```

**Example 4: A packed struct for parsing an IPv4 header and a test that checks layout.**

```zig
const std = @import("std");
const expect = std.testing.expect;

const IPv4Header = packed struct {
    ihl: u4,
    version: u4,
    ecn: u2,
    dscp: u6,
    total_length: u16,
    identification: u16,
    flags: u3,
    fragment_offset: u13,
    ttl: u8,
    protocol: u8,
    header_checksum: u16,
    source_ip: u32,
    dest_ip: u32,
};

test "IPv4 header layout" {
    try expect(@sizeOf(IPv4Header) == 20);

    const raw = [_]u8{
        0x45, 0x00, 0x00, 0x54, 0x00, 0x00, 0x40, 0x00,
        0x40, 0x01, 0xb7, 0x52, 0xc0, 0xa8, 0x00, 0x01,
        0xc0, 0xa8, 0x00, 0xc7,
    };
    const header = @as(*const IPv4Header, @ptrCast(&raw)).*;
    try expect(header.version == 4);
    try expect(header.ihl == 5);
    try expect(header.total_length == 84);
    try expect(header.protocol == 1); // ICMP
}
```

**Example 5: Opaque type to hide implementation and force heap allocation.**

```zig
const std = @import("std");

const Database = opaque {
    pub fn open(path: []const u8) !*Database {
        // In a real implementation we'd allocate the inner struct and return pointer.
        _ = path;
        const inner = try std.heap.page_allocator.create(InnerDatabase);
        inner.* = .{ .connection = 42 };
        return @ptrCast(inner);
    }

    pub fn close(db: *Database) void {
        const inner: *InnerDatabase = @ptrCast(db);
        std.heap.page_allocator.destroy(inner);
    }

    const InnerDatabase = struct {
        connection: i32,
    };
};

test "opaque database" {
    const db = try Database.open("test.db");
    defer db.close();
    // db has type *Database, cannot access fields directly.
}
```

