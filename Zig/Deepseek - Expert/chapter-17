## 8. Examples

### Complete program: parsing numbers from a file

```zig
const std = @import("std");

pub fn main() !void {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const args = try std.process.argsAlloc(allocator);
    defer std.process.argsFree(allocator, args);
    if (args.len < 2) return error.Usage;

    const sum = try processFile(args[1], allocator);
    std.debug.print("Sum: {d}\n", .{sum});
}

const FileError = error{
    OpenFailed,
    ReadFailed,
    ParseError,
};

fn processFile(path: []const u8, allocator: std.mem.Allocator) FileError!i64 {
    const file = std.fs.cwd().openFile(path, .{}) catch |err| {
        std.log.err("Cannot open {s}: {s}", .{ path, @errorName(err) });
        return error.OpenFailed;
    };
    defer file.close();

    const contents = file.readToEndAlloc(allocator, 1 << 20) catch |err| {
        std.log.err("Reading {s} failed: {s}", .{ path, @errorName(err) });
        return error.ReadFailed;
    };
    defer allocator.free(contents);

    var sum: i64 = 0;
    var it = std.mem.splitScalar(u8, contents, '\n');
    while (it.next()) |line| {
        if (line.len == 0) continue;
        const num = std.fmt.parseInt(i64, line, 10) catch |err| {
            std.log.err("Bad number '{s}': {s}", .{ line, @errorName(err) });
            return error.ParseError;
        };
        sum += num;
    }
    return sum;
}
```

### Custom retry logic with `catch`

```zig
fn fetchData(url: []const u8, max_retries: u8) ![]u8 {
    var attempts: u8 = 0;
    while (attempts < max_retries) : (attempts += 1) {
        if (attempts > 0) std.time.sleep(100 * std.time.ns_per_ms);
        const result = httpGet(url) catch |err| {
            if (err == error.ConnectionRefused or err == error.Timeout) {
                continue; // retry on these
            }
            return err; // other errors are fatal
        };
        return result; // success
    }
    return error.MaxRetriesExceeded;
}
```

### Error union destructuring with resource cleanup

```zig
fn copyOrWarn(src: []const u8, dst: []const u8) void {
    const in_file = std.fs.cwd().openFile(src, .{}) catch |err| {
        std.log.warn("Cannot open {s}: {s}", .{ src, @errorName(err) });
        return;
    };
    defer in_file.close();

    const out_file = std.fs.cwd().createFile(dst, .{}) catch |err| {
        std.log.warn("Cannot create {s}: {s}", .{ dst, @errorName(err) });
        return;
    };
    defer out_file.close();

    // Actual copy would go here ...
}
```

