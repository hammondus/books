## 8. Examples

All examples are self‑contained and compilable with `zig build-exe <file>` or `zig test <file>`.

### Example 1: JSON Value Type

```zig
const std = @import("std");
const Allocator = std.mem.Allocator;

const JsonValue = union(enum) {
    null: void,
    bool: bool,
    number: f64,
    string: []const u8,
    array: std.ArrayList(JsonValue),
    object: std.StringHashMap(JsonValue),

    pub fn deinit(self: *JsonValue, allocator: Allocator) void {
        switch (self.*) {
            .array => |*arr| {
                for (arr.items) |*item| item.deinit(allocator);
                arr.deinit();
            },
            .object => |*obj| {
                var it = obj.iterator();
                while (it.next()) |entry| {
                    allocator.free(entry.key_ptr.*);
                    entry.value_ptr.deinit(allocator);
                }
                obj.deinit();
            },
            else => {}, // scalar types own no heap memory
        }
        self.* = .null;
    }
};

test "JSON value lifecycle" {
    const testing = std.testing;
    const allocator = testing.allocator;

    var obj = std.StringHashMap(JsonValue).init(allocator);
    defer obj.deinit();

    // Build a simple object: {"pi": 3.14}
    try obj.put("pi", .{ .number = 3.14 });

    var val: JsonValue = .{ .object = obj };
    defer val.deinit(allocator);

    try testing.expect(val == .object);
}
```

### Example 2: State Machine for TCP Connection

```zig
const std = @import("std");
const net = std.net;
const Allocator = std.mem.Allocator;

const ConnectionState = union(enum) {
    idle,
    connecting: net.Stream, // not yet established
    connected: net.Stream,
    error: []const u8,
};

const Connection = struct {
    state: ConnectionState,
    allocator: Allocator,

    pub fn init(allocator: Allocator) Connection {
        return .{ .state = .idle, .allocator = allocator };
    }

    pub fn connect(self: *Connection, address: []const u8) !void {
        self.state = .{
            .connecting = try net.tcpConnectToHost(self.allocator, address, 80),
        };
    }

    pub fn advance(self: *Connection) !void {
        switch (self.state) {
            .connecting => |stream| {
                // assume handshake succeeds; transition to connected
                self.state = .{ .connected = stream };
            },
            .connected => {
                // keep alive or something
            },
            .error => |msg| {
                std.debug.print("error: {s}\n", .{msg});
                self.state = .idle;
            },
            .idle => {},
        }
    }

    pub fn deinit(self: *Connection) void {
        switch (self.state) {
            .connecting => |s| s.close(),
            .connected => |s| s.close(),
            else => {},
        }
    }
};
```

### Example 3: Expression Evaluator with Recursive Switch

```zig
const std = @import("std");
const Allocator = std.mem.Allocator;

pub const Expr = union(enum) {
    number: f64,
    add: struct { left: *Expr, right: *Expr },
    mul: struct { left: *Expr, right: *Expr },
};

pub fn evaluate(expr: *const Expr) f64 {
    return switch (expr.*) {
        .number => |n| n,
        .add => |op| evaluate(op.left) + evaluate(op.right),
        .mul => |op| evaluate(op.left) * evaluate(op.right),
    };
}

pub fn deinit(expr: *Expr, allocator: Allocator) void {
    switch (expr.*) {
        .add => |*op| {
            deinit(op.left, allocator);
            deinit(op.right, allocator);
            allocator.destroy(op.left);
            allocator.destroy(op.right);
        },
        .mul => |*op| {
            deinit(op.left, allocator);
            deinit(op.right, allocator);
            allocator.destroy(op.left);
            allocator.destroy(op.right);
        },
        .number => {},
    }
    // no self-destruction; caller owns the root allocation
}

test "evaluate simple expression" {
    const allocator = std.testing.allocator;

    const left = try allocator.create(Expr);
    left.* = .{ .number = 2.0 };
    const right = try allocator.create(Expr);
    right.* = .{ .number = 3.0 };
    const sum = try allocator.create(Expr);
    sum.* = .{ .add = .{ .left = left, .right = right } };

    defer {
        deinit(sum, allocator);
        allocator.destroy(sum);
    }

    const result = evaluate(sum);
    try std.testing.expectEqual(5.0, result);
}
```

