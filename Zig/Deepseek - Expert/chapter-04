### 8. Examples

The following complete, buildable program demonstrates variables, constants, `undefined`, type inference, and using types as values. It is a toy “command reader” that accepts a command from a pre-defined buffer, parses an integer argument, and prints the result.

```zig
const std = @import("std");

pub fn main() !void {
    // Command buffer – filled later, explicitly uninitialized now
    var cmd_buffer: [64]u8 = undefined;

    // Simulate reading a command (e.g., "SET 42")
    const simulated_input = "SET 42";
    @memcpy(cmd_buffer[0..simulated_input.len], simulated_input);
    const cmd_len = simulated_input.len;

    const cmd_str = cmd_buffer[0..cmd_len];

    // Split into command name and argument
    const space_pos = std.mem.indexOfScalar(u8, cmd_str, ' ') orelse {
        std.debug.print("Invalid command\n", .{});
        return;
    };

    const name = cmd_str[0..space_pos];
    const arg_str = cmd_str[space_pos + 1 ..];

    // Parse argument – we use a mutable variable for the result
    const arg_value = try std.fmt.parseInt(i32, arg_str, 10);

    // Dispatch using a constant mapping of command names to type
    const result = dispatch(name, arg_value);
    std.debug.print("Result: {}\n", .{result});
}

fn dispatch(comptime name: []const u8, value: i32) i32 {
    // comptime parameter allows compile-time dispatch
    if (std.mem.eql(u8, name, "SET")) {
        return value;
    } else if (std.mem.eql(u8, name, "ADD")) {
        return value + 1;
    }
    // unreachable for this example
    return 0;
}

// Test block verifying variable mutability concepts
test "var vs const and undefined" {
    // var mutability
    var x: u32 = 10;
    x = 20;
    try std.testing.expectEqual(20, x);

    // const prevents reassignment
    const y: u32 = 30;
    // y = 40; // would be compile error

    // undefined followed by write
    var buffer: [8]u8 = undefined;
    @memset(&buffer, 0xAA);
    try std.testing.expectEqual(@as(u8, 0xAA), buffer[0]);

    // type inference
    const inferred = 42;
    try std.testing.expectEqual(@as(comptime_int, 42), inferred);

    // type as value
    const T = if (true) u16 else u8;
    var val: T = 1000;
    try std.testing.expectEqual(@as(u16, 1000), val);
}

test "const pointer to mutable memory" {
    var data: u32 = 7;
    const ptr = &data;      // ptr is *u32, immutable binding
    ptr.* += 1;
    try std.testing.expectEqual(@as(u32, 8), data);
}

test "const pointer to const memory" {
    var data: u32 = 7;
    const ptr: *const u32 = &data;
    // ptr.* += 1;        // compile error: cannot assign to const
    _ = ptr;
}
```

This example can be built with `zig build-exe` (or `zig test` for the test blocks). It illustrates explicit mutability, `undefined` usage for a buffer, type inference, and the separation between binding mutability and pointer target mutability.

