### 8. Examples

All examples are self‑contained and can be run with `zig test <filename>.zig`.

#### Example 1: Table‑Driven Test with Allocator

```zig
const std = @import("std");

/// Joins a slice of strings with a delimiter.
fn joinStrings(ally: std.mem.Allocator, delim: []const u8, parts: []const []const u8) ![]u8 {
    if (parts.len == 0) return ally.dupe(u8, "");

    var total_len: usize = delim.len * (parts.len - 1);
    for (parts) |p| total_len += p.len;

    const buf = try ally.alloc(u8, total_len);
    errdefer ally.free(buf);

    var stream = std.io.fixedBufferStream(buf);
    const writer = stream.writer();
    for (parts, 0..) |p, i| {
        if (i > 0) try writer.writeAll(delim);
        try writer.writeAll(p);
    }
    return buf;
}

test "joinStrings: table-driven" !void {
    const ally = std.testing.allocator;

    const cases = [_]struct {
        delim: []const u8,
        parts: []const []const u8,
        expected: []const u8,
    }{
        .{ .delim = ", ", .parts = &.{ "a", "b", "c" }, .expected = "a, b, c" },
        .{ .delim = "",   .parts = &.{ "a", "b" },     .expected = "ab" },
        .{ .delim = " ",  .parts = &.{},               .expected = "" },
    };

    for (cases) |tc| {
        const result = try joinStrings(ally, tc.delim, tc.parts);
        defer ally.free(result);
        try std.testing.expectEqualStrings(tc.expected, result);
    }
}
```

#### Example 2: Fuzz Testing a Simple Parser

```zig
const std = @import("std");

/// Parses a `key=value` pair, returning both parts.
fn parseKeyValue(input: []const u8) !struct { key: []const u8, value: []const u8 } {
    const eq_pos = std.mem.indexOfScalar(u8, input, '=') orelse return error.InvalidFormat;
    if (eq_pos == 0) return error.MissingKey;
    if (eq_pos == input.len - 1) return error.MissingValue;
    return .{
        .key   = input[0..eq_pos],
        .value = input[eq_pos+1..],
    };
}

test "fuzz parseKeyValue" !void {
    try std.testing.fuzz(struct {
        fn testOne(input: []const u8) anyerror!void {
            if (parseKeyValue(input)) |pair| {
                // If successful, key and value must be non‑empty
                _ = pair;
                // We could add invariants here: e.g., key must not contain '='
            } else |_| {
                // Errors are expected for malformed input; that's fine
            }
        }
    }.testOne, .{});
}
```

