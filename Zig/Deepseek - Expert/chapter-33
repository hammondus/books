### 8. Examples

Let’s build a complete command‑line tool: **`zfind`** – a simple file finder that recursively searches for filenames containing a pattern, with an optional minimum file size filter. This example demonstrates file operations, directory recursion, command‑line argument parsing, and error handling in a real‑world style.

```zig
const std = @import("std");

pub fn main() !void {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const args = try std.process.argsAlloc(allocator);
    defer std.process.argsFree(allocator, args);

    if (args.len < 3) {
        std.debug.print("Usage: {s} <dir> <pattern> [min_size_bytes]\n", .{args[0]});
        return error.InvalidArgs;
    }

    const dir_path = args[1];
    const pattern = args[2];
    const min_size: u64 = if (args.len > 3) try std.fmt.parseInt(u64, args[3], 10) else 0;

    var dir = try std.fs.cwd().openDir(dir_path, .{ .iterate = true });
    defer dir.close();

    // Use a recursive function that carries an allocator for path joining
    try searchDir(allocator, dir, pattern, min_size, dir_path);
}

fn searchDir(
    allocator: std.mem.Allocator,
    dir: std.fs.Dir,
    pattern: []const u8,
    min_size: u64,
    base_path: []const u8,
) !void {
    var it = dir.iterate();
    while (try it.next()) |entry| {
        if (std.mem.eql(u8, entry.name, ".") or std.mem.eql(u8, entry.name, "..")) continue;

        const full_path = try std.fs.path.join(allocator, &.{ base_path, entry.name });
        defer allocator.free(full_path);

        switch (entry.kind) {
            .file => {
                // Skip if filename doesn't contain pattern
                if (std.mem.indexOf(u8, entry.name, pattern) == null) continue;

                // Check size if min_size > 0
                if (min_size > 0) {
                    const stat = try dir.statFile(entry.name);
                    if (stat.size < min_size) continue;
                }
                std.debug.print("{s}\n", .{full_path});
            },
            .directory => {
                var sub_dir = try dir.openDir(entry.name, .{ .iterate = true });
                defer sub_dir.close();
                try searchDir(allocator, sub_dir, pattern, min_size, full_path);
            },
            else => {}, // ignore symlinks, pipes, etc.
        }
    }
}
```

You can compile with `zig build-exe zfind.zig` and run:

```
$ zfind . "zig" 1024
./src/main.zig
./lib/ziglib.zig
```

#### Testing the Tool

We can write a test that creates a temporary directory, populates it, runs the search logic programmatically, and checks the output.

```zig
test "zfind finds matching files" {
    const tmp = std.testing.tmpDir(.{});
    defer tmp.cleanup();

    // Create test structure
    const dir = tmp.dir;
    try dir.writeFile("readme.txt", "hello");
    try dir.writeFile("src/main.zig", "content");
    {
        var sub = try dir.makeOpenPath("subdir", .{});
        defer sub.close();
        try sub.writeFile("lib.zig", "code");
    }

    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    // We'll capture printed output by redirecting std.debug
    var buf = std.ArrayList(u8).init(allocator);
    defer buf.deinit();

    // Temporarily override std.debug writer (simplified for test)
    // Instead, we'll just call a test‑specific function that collects results.
    var results = std.ArrayList([]const u8).init(allocator);
    defer results.deinit();

    // Use our search logic but with a callback
    const Ctx = struct {
        results: *std.ArrayList([]const u8),
        allocator: std.mem.Allocator,
        fn add(ctx: @This(), path: []const u8) !void {
            const owned = try ctx.allocator.dupe(u8, path);
            try ctx.results.append(owned);
        }
    };
    var ctx = Ctx{ .results = &results, .allocator = allocator };

    try searchDirTest(allocator, dir, "zig", 0, ".", ctx);

    // Verify we found both zig files
    try std.testing.expectEqual(@as(usize, 2), results.items.len);
}

// searchDirTest is like searchDir but calls ctx.add instead of printing
fn searchDirTest(
    allocator: std.mem.Allocator,
    dir: std.fs.Dir,
    pattern: []const u8,
    min_size: u64,
    base_path: []const u8,
    ctx: anytype,
) !void {
    var it = dir.iterate();
    while (try it.next()) |entry| {
        if (std.mem.eql(u8, entry.name, ".") or std.mem.eql(u8, entry.name, "..")) continue;
        const full_path = try std.fs.path.join(allocator, &.{ base_path, entry.name });
        defer allocator.free(full_path);

        switch (entry.kind) {
            .file => {
                if (std.mem.indexOf(u8, entry.name, pattern) != null) {
                    if (min_size > 0) {
                        const stat = try dir.statFile(entry.name);
                        if (stat.size < min_size) continue;
                    }
                    try ctx.add(full_path);
                }
            },
            .directory => {
                var sub = try dir.openDir(entry.name, .{ .iterate = true });
                defer sub.close();
                try searchDirTest(allocator, sub, pattern, min_size, full_path, ctx);
            },
            else => {},
        }
    }
}
```

This test uses the standard library’s `std.testing.tmpDir`, which automatically cleans up after the test.

