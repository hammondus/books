### 8. Examples

Below is the complete, compilable implementation of `kv.zig`, including a test block. You can build it with `zig build-exe kv.zig` (if you add a `pub fn main`) or run tests with `zig test kv.zig`.

```zig
const std = @import("std");

/// A concurrent, sharded key-value store.
/// K and V must be comparable with `==` (via std.meta.eql).
/// hash_fn must produce a u64 hash from a key.
pub fn KeyValueStore(
    comptime K: type,
    comptime V: type,
    comptime hash_fn: fn (K) u64,
) type {
    return struct {
        const Self = @This();

        const Shard = struct {
            mutex: std.Thread.Mutex = .{},
            list: std.ArrayListUnmanaged(Entry) = .{},

            const Entry = struct {
                key: K,
                value: V,
            };
        };

        allocator: std.mem.Allocator,
        shards: []Shard,
        shard_mask: u64,

        /// Initializes the store. num_shards is rounded up to the next power of two.
        pub fn init(allocator: std.mem.Allocator, options: struct {
            num_shards: u16,
        }) !Self {
            const num = std.math.ceilPowerOfTwo(u16, options.num_shards) catch
                return error.InvalidArgument;
            const shards = try allocator.alloc(Shard, num);
            errdefer allocator.free(shards);
            @memset(shards, .{});
            return Self{
                .allocator = allocator,
                .shards = shards,
                .shard_mask = num - 1,
            };
        }

        /// Frees all memory used by the store.
        pub fn deinit(self: *Self) void {
            for (self.shards) |*s| {
                s.list.deinit(self.allocator);
            }
            self.allocator.free(self.shards);
        }

        fn getShard(self: *const Self, key: K) *Shard {
            const h = hash_fn(key);
            const idx = h & self.shard_mask;
            return &self.shards[idx];
        }

        /// Inserts or updates the key-value pair. Returns OutOfMemory on allocation failure.
        pub fn put(self: *Self, key: K, value: V) !void {
            const shard = self.getShard(key);
            shard.mutex.lock();
            defer shard.mutex.unlock();

            for (shard.list.items) |*entry| {
                if (std.meta.eql(entry.key, key)) {
                    entry.value = value;
                    return;
                }
            }
            try shard.list.append(self.allocator, .{ .key = key, .value = value });
        }

        /// Returns the value associated with key, or null if not present.
        pub fn get(self: *const Self, key: K) ?V {
            const shard = self.getShard(key);
            shard.mutex.lock();
            defer shard.mutex.unlock();

            for (shard.list.items) |entry| {
                if (std.meta.eql(entry.key, key)) {
                    return entry.value;
                }
            }
            return null;
        }

        /// Removes the key. Returns true if it existed.
        pub fn delete(self: *Self, key: K) bool {
            const shard = self.getShard(key);
            shard.mutex.lock();
            defer shard.mutex.unlock();

            for (shard.list.items, 0..) |entry, i| {
                if (std.meta.eql(entry.key, key)) {
                    _ = shard.list.swapRemove(i);
                    return true;
                }
            }
            return false;
        }
    };
}

test "basic operations" {
    const ally = std.testing.allocator;
    var store = KeyValueStore(u32, u32, std.hash.autoHash).init(ally, .{ .num_shards = 4 });
    defer store.deinit();

    // Put and get
    try store.put(10, 100);
    try store.put(20, 200);
    try std.testing.expectEqual(@as(?u32, 100), store.get(10));
    try std.testing.expectEqual(@as(?u32, 200), store.get(20));
    try std.testing.expectEqual(@as(?u32, null), store.get(30));

    // Update
    try store.put(10, 999);
    try std.testing.expectEqual(@as(?u32, 999), store.get(10));

    // Delete
    try std.testing.expectEqual(true, store.delete(10));
    try std.testing.expectEqual(false, store.delete(10));
    try std.testing.expectEqual(@as(?u32, null), store.get(10));

    // Remaining key still intact
    try std.testing.expectEqual(@as(?u32, 200), store.get(20));
}

test "concurrent access" {
    const ally = std.testing.allocator;
    var store = KeyValueStore(u32, u32, std.hash.autoHash).init(ally, .{ .num_shards = 8 });
    defer store.deinit();

    const num_threads = 4;
    const ops_per_thread = 1000;

    const threads = try ally.alloc(std.Thread, num_threads);
    defer ally.free(threads);

    for (0..num_threads) |t| {
        const start = t * ops_per_thread;
        threads[t] = try std.Thread.spawn(.{}, struct {
            fn run(s: *@TypeOf(store), begin: u32, count: u32) !void {
                var i: u32 = 0;
                while (i < count) : (i += 1) {
                    const key = begin + i;
                    try s.put(key, key * 10);
                }
                // Read them back
                i = 0;
                while (i < count) : (i += 1) {
                    const key = begin + i;
                    const val = s.get(key);
                    std.debug.assert(val != null and val.? == key * 10);
                }
            }
        }.run, .{ &store, @intCast(start), @intCast(ops_per_thread) });
    }
    for (threads) |th| th.join();
}

test "delete and concurrent gets" {
    const ally = std.testing.allocator;
    var store = KeyValueStore(u32, u32, std.hash.autoHash).init(ally, .{ .num_shards = 4 });
    defer store.deinit();

    try store.put(1, 100);
    const getter = try std.Thread.spawn(.{}, struct {
        fn run(s: *const @TypeOf(store)) void {
            var i: usize = 0;
            while (i < 10_000) : (i += 1) {
                _ = s.get(1);
            }
        }
    }.run, .{&store});
    _ = store.delete(1);
    getter.join();
    try std.testing.expect(store.get(1) == null);
}
```

This example is self‑contained and passes `zig test`. It exercises insertion, update, deletion, and basic multi‑threaded access, with `std.testing.allocator` detecting leaks.

