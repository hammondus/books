### 8. Examples

Let’s build a more complete, buildable example that demonstrates a modest project structure with a library, an executable, tests, and dependency injection. We’ll simulate a simple “user service” that sends a welcome email. The email sender is abstracted behind an interface.

#### Project Structure

```
welcome_app/
  build.zig
  build.zig.zon
  src/
    main.zig
    lib.zig
    email/
      mod.zig
      interface.zig
      smtp_sender.zig
    user_service.zig
  tests/
    test_user_service.zig
```

##### `src/email/interface.zig`

Defines the EmailSender interface as a struct of function pointers.

```zig
const std = @import("std");

pub const Email = struct {
    to: []const u8,
    subject: []const u8,
    body: []const u8,
};

pub const EmailSender = struct {
    ptr: *anyopaque,
    sendFn: *const fn (ptr: *anyopaque, allocator: std.mem.Allocator, email: Email) anyerror!void,

    pub fn send(self: EmailSender, allocator: std.mem.Allocator, email: Email) !void {
        return self.sendFn(self.ptr, allocator, email);
    }
};
```

##### `src/email/smtp_sender.zig`

A concrete implementation that (pretends to) deliver emails via SMTP.

```zig
const std = @import("std");
const iface = @import("interface.zig");

pub const SmtpSender = struct {
    server: []const u8,
    port: u16,

    pub fn init(server: []const u8, port: u16) SmtpSender {
        return .{ .server = server, .port = port };
    }

    fn sendImpl(ptr: *anyopaque, allocator: std.mem.Allocator, email: iface.Email) anyerror!void {
        const self: *SmtpSender = @ptrCast(@alignCast(ptr));
        _ = allocator; // would be used to format SMTP commands
        _ = self;
        // Simulate sending
        std.debug.print("Sending email to {s} via {s}:{d}\n", .{ email.to, self.server, self.port });
    }

    pub fn sender(self: *SmtpSender) iface.EmailSender {
        return .{
            .ptr = self,
            .sendFn = sendImpl,
        };
    }
};
```

##### `src/email/mod.zig`

Re‑exports the public interface.

```zig
pub const interface = @import("interface.zig");
pub const smtp_sender = @import("smtp_sender.zig");
```

##### `src/user_service.zig`

Contains business logic that depends on an `EmailSender`.

```zig
const std = @import("std");
const email = @import("email/mod.zig");

pub fn sendWelcomeEmail(
    allocator: std.mem.Allocator,
    sender: email.interface.EmailSender,
    user_email: []const u8,
) !void {
    const welcome = email.interface.Email{
        .to = user_email,
        .subject = "Welcome!",
        .body = "Thank you for joining.",
    };
    try sender.send(allocator, welcome);
}
```

##### `src/lib.zig`

Simply re‑exports the public API of the library.

```zig
pub const user_service = @import("user_service.zig");
pub const email = @import("email/mod.zig");
```

##### `src/main.zig`

Wires everything together: creates the SMTP sender and calls the service.

```zig
const std = @import("std");
const lib = @import("lib.zig");

pub fn main() !void {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    var smtp = lib.email.smtp_sender.SmtpSender.init("smtp.example.com", 587);
    const sender = smtp.sender();

    const args = try std.process.argsAlloc(allocator);
    defer std.process.argsFree(allocator, args);
    if (args.len < 2) {
        std.debug.print("Usage: welcome_app <email>\n", .{});
        return error.MissingArgument;
    }

    try lib.user_service.sendWelcomeEmail(allocator, sender, args[1]);
}
```

##### `tests/test_user_service.zig`

Tests the user service with a mock sender.

```zig
const std = @import("std");
const lib = @import("../src/lib.zig");

const MockSender = struct {
    sent_count: u32 = 0,

    fn sendImpl(ptr: *anyopaque, allocator: std.mem.Allocator, email: lib.email.interface.Email) anyerror!void {
        const self: *MockSender = @ptrCast(@alignCast(ptr));
        _ = allocator;
        _ = email;
        self.sent_count += 1;
    }

    fn sender(self: *MockSender) lib.email.interface.EmailSender {
        return .{
            .ptr = self,
            .sendFn = sendImpl,
        };
    }
};

test "sendWelcomeEmail calls sender once" {
    const allocator = std.testing.allocator;
    var mock = MockSender{};
    const sender = mock.sender();

    try lib.user_service.sendWelcomeEmail(allocator, sender, "test@example.com");
    try std.testing.expectEqual(@as(u32, 1), mock.sent_count);
}
```

##### `build.zig`

```zig
const std = @import("std");

pub fn build(b: *std.Build) void {
    const target = b.standardTargetOptions(.{});
    const optimize = b.standardOptimizeOption(.{});

    const exe = b.addExecutable(.{
        .name = "welcome_app",
        .root_source_file = b.path("src/main.zig"),
        .target = target,
        .optimize = optimize,
    });
    b.installArtifact(exe);

    const tests = b.addTest(.{
        .root_source_file = b.path("tests/test_user_service.zig"),
        .target = target,
        .optimize = optimize,
    });
    const run_tests = b.addRunArtifact(tests);
    const test_step = b.step("test", "Run unit tests");
    test_step.dependOn(&run_tests.step);
}
```

