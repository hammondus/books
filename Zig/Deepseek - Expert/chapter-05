### 5.8 Examples

#### Example 1: Generic max function with comptime

```zig
const std = @import("std");

pub fn max(comptime T: type, a: T, b: T) T {
    // comptime branch: if T supports >, use it; else compare bytes
    return if (comptime @hasDecl(T, "gt")) a.gt(b) else if (a > b) a else b;
}

test "max with integers" {
    try std.testing.expectEqual(@as(i32, 10), max(i32, 5, 10));
}

test "max with floats" {
    try std.testing.expectEqual(@as(f64, 3.14), max(f64, 1.5, 3.14));
}
```

#### Example 2: Function that accepts an allocator and returns an error union

```zig
const std = @import("std");

fn readAndTrim(allocator: std.mem.Allocator, file_path: []const u8) ![]u8 {
    const file = try std.fs.cwd().openFile(file_path, .{});
    defer file.close();

    const stat = try file.stat();
    const raw = try file.readToEndAlloc(allocator, stat.size);
    // Note: caller is responsible for freeing `raw`
    errdefer allocator.free(raw);

    // Trim whitespace
    var trimmed = std.mem.trim(u8, raw, " \t\r\n");
    // Return a new allocation of the trimmed slice
    const result = try allocator.dupe(u8, trimmed);
    allocator.free(raw);
    return result;
}

pub fn main() !void {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const content = try readAndTrim(gpa.allocator(), "data.txt");
    defer gpa.allocator().free(content);
    std.debug.print("Content: '{s}'\n", .{content});
}
```

#### Example 3: Inline function for compile-time known arguments

```zig
inline fn saturatingAdd(a: u8, b: u8) u8 {
    const sum = a +% b; // wrapping add
    return if (sum < a or sum < b) 255 else sum;
}

test "saturatingAdd inlined" {
    // The call is fully expanded at compile time
    try std.testing.expectEqual(@as(u8, 255), saturatingAdd(200, 100));
}
```

#### Example 4: Using `@call` to build a dynamic dispatch system

```zig
const std = @import("std");

const Operation = enum { add, sub, mul };

fn apply(op: Operation, a: i32, b: i32) i32 {
    const impl = switch (op) {
        .add => addFn,
        .sub => subFn,
        .mul => mulFn,
    };
    return @call(.auto, impl, .{a, b});
}

fn addFn(a: i32, b: i32) i32 { return a + b; }
fn subFn(a: i32, b: i32) i32 { return a - b; }
fn mulFn(a: i32, b: i32) i32 { return a * b; }

test "@call dispatch" {
    try std.testing.expectEqual(42, apply(.add, 30, 12));
    try std.testing.expectEqual(18, apply(.sub, 30, 12));
    try std.testing.expectEqual(360, apply(.mul, 30, 12));
}
```

All examples compile with `zig test` or `zig build-exe` (add `pub fn main() !void` where needed).

