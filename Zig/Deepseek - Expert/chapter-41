## 8. Examples

### 8.1 Calculator Library (Minimal)

This example exports a few arithmetic functions and a string length counter. No allocations; pure computation.

```zig
export fn add(a: i32, b: i32) callconv(.C) i32 { return a + b; }
export fn subtract(a: i32, b: i32) callconv(.C) i32 { return a - b; }
export fn multiply(a: i32, b: i32) callconv(.C) i32 { return a * b; }

export fn string_len(ptr: [*]const u8) callconv(.C) usize {
    return std.mem.len(ptr); // assumes null-terminated string
}
```

Build with `zig build-exe src/calc.zig -target wasm32-freestanding -fno-entry -dynamic`. The resulting WASM is a few hundred bytes.

### 8.2 Base64 Encoder with Custom Memory Management

This module encodes a binary buffer to a base64 string. JavaScript provides the input buffer and receives the output in a caller-provided buffer. If the output buffer is too small, the function returns the required size.

```zig
const std = @import("std");

export fn b64_encode_length(input_len: usize) callconv(.C) usize {
    return std.base64.standard.Encoder.calcSize(input_len);
}

export fn b64_encode(
    input: [*]const u8,
    input_len: usize,
    output: [*]u8,
    output_len: usize,
) callconv(.C) usize {
    const in_slice = input[0..input_len];
    const out_slice = output[0..output_len];
    const encoded = std.base64.standard.Encoder.encode(out_slice, in_slice);
    return encoded.len;
}
```

JavaScript side:

```js
const input = new TextEncoder().encode("Hello, Zig!");
const len = wasm.instance.exports.b64_encode_length(input.length);
const outPtr = wasm.instance.exports.alloc(len);
const written = wasm.instance.exports.b64_encode(
    inputPtr, input.length, outPtr, len
);
const output = new TextDecoder().decode(
    new Uint8Array(memory.buffer, outPtr, written)
);
wasm.instance.exports.dealloc(outPtr, len);
console.log(output);
```

No hidden string allocation; the caller manages both buffers.

### 8.3 WASI Word Counter

This program reads a file passed as a command-line argument and prints the top 10 most frequent words. It compiles to a WASI binary.

```zig
const std = @import("std");

pub fn main() !void {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const args = try std.process.argsAlloc(allocator);
    defer std.process.argsFree(allocator, args);
    if (args.len < 2) {
        std.debug.print("Usage: {s} <file>\n", .{args[0]});
        return;
    }
    const filename = args[1];
    const file = try std.fs.cwd().openFile(filename, .{});
    defer file.close();

    const content = try file.readToEndAlloc(allocator, 1024 * 1024);
    defer allocator.free(content);

    var word_counts = std.StringHashMap(usize).init(allocator);
    defer word_counts.deinit();

    var it = std.mem.splitScalar(u8, content, ' ');
    while (it.next()) |word| {
        if (word.len == 0) continue;
        const entry = try word_counts.getOrPut(word);
        if (entry.found_existing) {
            entry.value_ptr.* += 1;
        } else {
            entry.value_ptr.* = 1;
        }
    }

    var stdout = std.io.getStdOut().writer();
    var entries = try allocator.alloc(struct { word: []const u8, count: usize }, word_counts.count());
    defer allocator.free(entries);
    {
        var i: usize = 0;
        var iter = word_counts.iterator();
        while (iter.next()) |kv| {
            entries[i] = .{ .word = kv.key_ptr.*, .count = kv.value_ptr.* };
            i += 1;
        }
    }
    std.mem.sort(struct { word: []const u8, count: usize }, entries, {}, struct {
        fn lessThan(_: void, a: @TypeOf(entries[0]), b: @TypeOf(entries[0])) bool {
            return a.count > b.count;
        }
    }.lessThan);

    for (entries) |e| {
        try stdout.print("{s}: {d}\n", .{ e.word, e.count });
    }
}
```

Run with `wasmtime --dir=. wordcount.wasm myfile.txt`. This demonstrates full stdlib usage in a WASI environment.

