### 6.8 Examples

#### Example 1: Parsing a tagged union state machine

```zig
const std = @import("std");

const State = union(enum) {
    idle,
    connecting: u32,
    connected: struct { addr: u32, port: u16 },
    error: []const u8,
};

fn describe(state: State) []const u8 {
    return switch (state) {
        .idle => "Idle",
        .connecting => |timeout| {
            // timeout is a u32, but we return a static string; we need a buffer
            // For simplicity, we just say "Connecting..."
            _ = timeout;
            return "Connecting...";
        },
        .connected => |info| {
            _ = info;
            return "Connected";
        },
        .error => |msg| msg,
    };
}
```

This showcases exhaustive switching and payload capture.

#### Example 2: Using a labeled block to exit nested loops

```zig
const items = [_][3]u32{
    .{ 1, 2, 3 },
    .{ 4, 5, 6 },
    .{ 7, 8, 9 },
};

const target: u32 = 5;
const found = loc: {
    for (items, 0..) |row, i| {
        for (row, 0..) |val, j| {
            if (val == target) break :loc .{ i, j };
        }
    }
    break :loc null;
};
if (found) |pos| {
    std.debug.print("Found at ({d},{d})\n", .{ pos[0], pos[1] });
} else {
    std.debug.print("Not found\n", .{});
}
```

#### Example 3: Comptime branch for algorithm selection

```zig
const builtin = @import("builtin");

fn compute(input: []const u8) u32 {
    if (builtin.target.cpu.arch == .x86_64) {
        // Use an x86_64 specific intrinsic or optimized path
        return x86_specific(input);
    } else {
        // Generic fallback
        return generic(input);
    }
}
```

Only the relevant function call is emitted for the target.

#### Example 4: `while` with optional capture and else

```zig
const std = @import("std");

fn countLines(reader: anytype) !u32 {
    var buf: [1024]u8 = undefined;
    var lines: u32 = 0;
    while (try reader.readUntilDelimiterOrEof(&buf, '\n')) |line| {
        // line is a slice of the buffer
        _ = line;
        lines += 1;
    } else {
        // EOF reached without error
    }
    return lines;
}
```

The `else` block executes only if the loop exits because the optional became `null` (EOF) and not via `break`.

