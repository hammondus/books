## 20.8 Examples

### Example 1: Parsing a Binary Network Header with Packed Struct

This example reads a fixed‑length header from a slice, verifying alignment and extracting fields.

```zig
const std = @import("std");

const ProtocolHeader = packed struct {
    version: u2,
    type: u4,
    flags: u2,
    length: u16,
};

fn parseHeader(buffer: []const u8) !*const ProtocolHeader {
    if (buffer.len < @sizeOf(ProtocolHeader)) return error.ShortBuffer;
    const addr = @intFromPtr(buffer.ptr);
    // Packed structs have alignment 1, but the buffer must be at least align(2) for the u16 field.
    if (addr % @alignOf(ProtocolHeader) != 0) return error.Unaligned;
    return @ptrCast(@alignCast(buffer.ptr));
}

test "parse valid header" {
    // Build a little‑endian header: version=0b10, type=0b1010, flags=0b01, length=0x4321
    const raw = [_]u8{
        0b01_10_1010, // bits: flags(2) type(4) version(2) from LSB
        0x21, 0x43,   // length = 0x4321 LE
    };
    const h = try parseHeader(&raw);
    try std.testing.expect(h.version == 2);
    try std.testing.expect(h.type == 10);
    try std.testing.expect(h.flags == 1);
    try std.testing.expect(h.length == 0x4321);
}
```

### Example 2: Cache‑Line Alignment to Avoid False Sharing

A concurrent ring buffer where the producer and consumer indices are on separate cache lines to prevent ping‑ponging.

```zig
const std = @import("std");

const CacheLineSize = 64;

const SPSCQueue = struct {
    buffer: []u8,
    read_index: usize align(CacheLineSize),
    write_index: usize align(CacheLineSize),

    fn init(allocator: std.mem.Allocator, capacity: usize) !SPSCQueue {
        const buf = try allocator.alloc(u8, capacity);
        return SPSCQueue{
            .buffer = buf,
            .read_index = 0,
            .write_index = 0,
        };
    }

    fn push(self: *SPSCQueue, value: u8) !void {
        if (self.write_index - self.read_index >= self.buffer.len) return error.Full;
        self.buffer[self.write_index % self.buffer.len] = value;
        @atomicRmw(usize, &self.write_index, .Add, 1, .monotonic);
    }

    fn pop(self: *SPSCQueue) ?u8 {
        if (self.read_index == self.write_index) return null;
        const value = self.buffer[self.read_index % self.buffer.len];
        @atomicRmw(usize, &self.read_index, .Add, 1, .monotonic);
        return value;
    }
};

test "SPSC queue false sharing prevention" {
    // Ensure indices are on separate cache lines
    try std.testing.expect(@offsetOf(SPSCQueue, "read_index") % CacheLineSize == 0);
    try std.testing.expect(@offsetOf(SPSCQueue, "write_index") % CacheLineSize == 0);

    const allocator = std.testing.allocator;
    var q = try SPSCQueue.init(allocator, 8);
    defer allocator.free(q.buffer);
    try q.push(42);
    try std.testing.expectEqual(@as(?u8, 42), q.pop());
    try std.testing.expectEqual(@as(?u8, null), q.pop());
}
```

### Example 3: Comptime Verification of a C‑Compatible Struct

Ensuring an `extern struct` matches a known C layout without relying on runtime checks.

```zig
const CHeader = extern struct {
    tag: u32,
    value: u64,
};

comptime {
    // These assertions run at compile time.
    if (@sizeOf(CHeader) != 12) @compileError("Bad size");
    if (@offsetOf(CHeader, "tag") != 0) @compileError("tag offset wrong");
    if (@offsetOf(CHeader, "value") != 4) @compileError("value offset wrong");
}

test "extern struct size never changes" {
    // Just a runtime sanity check.
    try std.testing.expect(@sizeOf(CHeader) == 12);
}
```

