### 8. Examples

Each example is a complete, compilable program (assume a `build.zig` that links `libc` for the first, and a build command line for the others). The instructions assume Zig 0.13 or later.

#### 8.1 Calling C’s `qsort` Safely

This wraps the C standard library `qsort` with a comptime‑generated callback so that you can sort a Zig slice without writing `extern` comparison functions manually.

```zig
const std = @import("std");
const c = @cImport({
    @cInclude("stdlib.h");
});

fn qsortZig(comptime T: type, slice: []T, comptime cmp: fn (a: T, b: T) bool) void {
    const len: c_ulong = @intCast(slice.len);
    const size: c_ulong = @sizeOf(T);

    // Comptime‑generated function that matches C's signature.
    const compareFn = struct {
        fn f(ap: ?*const anyopaque, bp: ?*const anyopaque) callconv(.C) c_int {
            const a = @as(*const T, @ptrCast(@alignCast(ap.?))).*;
            const b = @as(*const T, @ptrCast(@alignCast(bp.?))).*;
            if (cmp(a, b)) return -1;
            if (cmp(b, a)) return 1;
            return 0;
        }
    }.f;

    c.qsort(slice.ptr, len, size, &compareFn);
}

pub fn main() void {
    var arr = [_]i32{ 3, 1, 4, 1, 5, 9, 2, 6 };
    qsortZig(i32, &arr, struct {
        fn less(a: i32, b: i32) bool { return a < b; }
    }.less);
    for (arr) |val| std.debug.print("{d} ", .{val});
    std.debug.print("\n", .{});
}
```

- `qsortZig` is comptime‑parameterised, so a new comparison function is generated per call site.
- The comparison callback uses C’s opaque pointers; we cast them back to Zig pointers with proper alignment.
- No runtime generics, no thunks.

#### 8.2 Exporting a Shared Library with a Safe Interface

`matmul.zig`:

```zig
const std = @import("std");

/// Allocates a row-major matrix of f32 (rows x cols). Caller must free with `free_matrix`.
export fn create_matrix(rows: u32, cols: u32) callconv(.C) ?*f32 {
    const alloc = std.heap.c_allocator;
    const slice = alloc.alloc(f32, rows * cols) catch return null;
    return slice.ptr;
}

export fn free_matrix(ptr: ?*f32) callconv(.C) void {
    if (ptr) |p| {
        const alloc = std.heap.c_allocator;
        // We can't know the length; this relies on the allocator's bookkeeping.
        alloc.free(p[0..0]); // Dummy slice; length inferred by allocator.
    }
}

export fn matrix_multiply(
    a: [*]const f32,
    b: [*]const f32,
    c: [*]f32,
    m: u32,
    n: u32,
    k: u32,
) callconv(.C) void {
    const am = @as(usize, m);
    const an = @as(usize, n);
    const bk = @as(usize, k);
    for (0..am) |i| {
        for (0..bk) |j| {
            var sum: f32 = 0;
            for (0..an) |inner| {
                sum += a[i * an + inner] * b[inner * bk + j];
            }
            c[i * bk + j] = sum;
        }
    }
}
```

Build:

```
$ zig build-lib -dynamic matmul.zig -femit-bin=libmatmul.so
```

A C consumer can use `create_matrix`, `matrix_multiply`, and `free_matrix` without knowing Zig exists. The `?*f32` return becomes a C `float*` that may be `NULL`. The exported API uses raw pointers and explicit sizes; a Zig wrapper could hide these details.

#### 8.3 Inline Assembly for a Spin‑Loop Hint

On x86_64, the `pause` instruction reduces power consumption and improves performance in spin‑wait loops. We expose it with a comptime‑guarded inline assembly.

```zig
const builtin = @import("builtin");

fn spinHint() void {
    if (builtin.cpu.arch == .x86_64) {
        asm volatile ("pause" ::: "memory");
    } else if (builtin.cpu.arch == .aarch64) {
        asm volatile ("yield" ::: "memory");
    }
    // Fallback: nothing.
}

pub fn main() void {
    var counter: u32 = 0;
    while (counter < 1000) : (counter += 1) {
        spinHint();
    }
    std.debug.print("done\n", .{});
}
```

- `asm volatile ("pause" ::: "memory")` has no inputs or outputs, only a memory clobber to prevent reordering.
- The comptime branch ensures we only emit the instruction on architectures that understand it.

#### 8.4 Reading the Time‑Stamp Counter

`rdtsc` is a x86 instruction that reads the processor’s cycle counter into `edx:eax`. We wrap it in a function returning a `u64`.

```zig
fn readCycleCounter() u64 {
    var low: u32 = undefined;
    var high: u32 = undefined;
    asm volatile ("rdtsc"
        : [lo] "={eax}" (low),
          [hi] "={edx}" (high),
        :
        : "memory"
    );
    return (@as(u64, high) << 32) | low;
}
```

