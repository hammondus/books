## 8. Examples

Here are three complete, buildable examples that crystallize the recipes.

**Example 1: Lock-free SPSC queue with producer/consumer threads**

```zig
const std = @import("std");

pub fn SpscQueue(comptime T: type, comptime capacity: comptime_int) type {
    if (!std.math.isPowerOfTwo(capacity)) @compileError("capacity must be power of two");
    return struct {
        const Mask = capacity - 1;
        buf: [capacity]T = undefined,
        write_idx: usize align(std.atomic.cache_line) = 0,
        read_idx: usize align(std.atomic.cache_line) = 0,
        const Self = @This();

        pub fn push(self: *Self, item: T) bool {
            const w = @atomicLoad(usize, &self.write_idx, .acquire);
            const r = @atomicLoad(usize, &self.read_idx, .acquire);
            if (w - r == capacity) return false;
            self.buf[w & Mask] = item;
            @atomicStore(usize, &self.write_idx, w + 1, .release);
            return true;
        }

        pub fn pop(self: *Self) ?T {
            const r = @atomicLoad(usize, &self.read_idx, .acquire);
            const w = @atomicLoad(usize, &self.write_idx, .acquire);
            if (r == w) return null;
            const item = self.buf[r & Mask];
            @atomicStore(usize, &self.read_idx, r + 1, .release);
            return item;
        }
    };
}

pub fn main() !void {
    var queue: SpscQueue(i32, 8) = .{};

    const producer = try std.Thread.spawn(.{}, struct {
        fn run(q: *@TypeOf(queue)) void {
            var i: i32 = 0;
            while (i < 100) {
                while (!q.push(i)) {} // busy-wait
                i += 1;
            }
        }
    }.run, .{&queue});
    const consumer = try std.Thread.spawn(.{}, struct {
        fn run(q: *@TypeOf(queue)) void {
            var received: i32 = 0;
            while (received < 100) {
                if (q.pop()) |val| {
                    std.debug.print("{d}\n", .{val});
                    received += 1;
                }
            }
        }
    }.run, .{&queue});

    producer.join();
    consumer.join();
}
```

**Example 2: Comptime-powered argument parser**

```zig
const std = @import("std");

const Options = struct {
    input: []const u8 = "default.txt",
    verbose: bool = false,
    count: u32 = 1,
};

pub fn parse(comptime T: type, allocator: std.mem.Allocator) !T {
    const args = try std.process.argsAlloc(allocator);
    defer std.process.argsFree(allocator, args);

    var opts: T = .{};
    const fields = @typeInfo(T).Struct.fields;
    var i: usize = 1;
    while (i < args.len) {
        const arg = args[i];
        if (std.mem.startsWith(u8, arg, "--")) {
            const name = arg[2..];
            var found = false;
            inline for (fields) |fld| {
                if (std.mem.eql(u8, name, fld.name)) {
                    if (i + 1 >= args.len) return error.MissingValue;
                    i += 1;
                    const val = args[i];
                    switch (@typeInfo(fld.type)) {
                        .Bool => @field(opts, fld.name) = true,
                        .Int => @field(opts, fld.name) = try std.fmt.parseInt(fld.type, val, 10),
                        .Pointer => |ptr| if (ptr.size == .Slice and ptr.child == u8) {
                            @field(opts, fld.name) = val;
                        } else @compileError("unsupported type"),
                        else => @compileError("unsupported type"),
                    }
                    found = true;
                }
            }
            if (!found) return error.UnknownOption;
        } else {
            // positional argument handling could go here
        }
        i += 1;
    }
    return opts;
}

pub fn main() !void {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const opts = try parse(Options, gpa.allocator());
    std.debug.print("input={s} verbose={} count={d}\n", .{ opts.input, opts.verbose, opts.count });
}
```

**Example 3: Binary protocol parser with endianness correction**

```zig
const std = @import("std");

const Ipv4Header = packed struct {
    version_ihl: u8, // version (4 bits) + IHL (4 bits)
    dscp_ecn: u8,
    total_length: u16,
    identification: u16,
    flags_fragment: u16,
    ttl: u8,
    protocol: u8,
    header_checksum: u16,
    src_addr: u32,
    dst_addr: u32,
};

pub fn parseIpv4(bytes: []const u8) !Ipv4Header {
    if (bytes.len < 20) return error.InvalidLength;
    // Copy to aligned stack variable to avoid alignment issues.
    var aligned: [20]u8 align(4) = undefined;
    @memcpy(&aligned, bytes[0..20]);
    const native_hdr: Ipv4Header = @bitCast(aligned);
    // Convert multi-byte fields to host byte order.
    return Ipv4Header{
        .version_ihl = native_hdr.version_ihl,
        .dscp_ecn = native_hdr.dscp_ecn,
        .total_length = std.mem.bigToNative(u16, native_hdr.total_length),
        .identification = std.mem.bigToNative(u16, native_hdr.identification),
        .flags_fragment = std.mem.bigToNative(u16, native_hdr.flags_fragment),
        .ttl = native_hdr.ttl,
        .protocol = native_hdr.protocol,
        .header_checksum = std.mem.bigToNative(u16, native_hdr.header_checksum),
        .src_addr = std.mem.bigToNative(u32, native_hdr.src_addr),
        .dst_addr = std.mem.bigToNative(u32, native_hdr.dst_addr),
    };
}

pub fn main() !void {
    const packet = [_]u8{
        0x45, 0x00, 0x00, 0x3c, 0x1c, 0x46, 0x40, 0x00,
        0x40, 0x06, 0xb1, 0xe6, 0xc0, 0xa8, 0x00, 0x68,
        0xc0, 0xa8, 0x00, 0x01,
    };
    const hdr = try parseIpv4(&packet);
    std.debug.print("src={d}.{d}.{d}.{d} dst={d}.{d}.{d}.{d}\n", .{
        (hdr.src_addr >> 24) & 0xff,
        (hdr.src_addr >> 16) & 0xff,
        (hdr.src_addr >> 8) & 0xff,
        hdr.src_addr & 0xff,
        (hdr.dst_addr >> 24) & 0xff,
        (hdr.dst_addr >> 16) & 0xff,
        (hdr.dst_addr >> 8) & 0xff,
        hdr.dst_addr & 0xff,
    });
}
```

