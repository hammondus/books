### 8. Examples – Complete and Buildable

#### 8.1 Compile-Time Function Evaluation

```zig
const std = @import("std");

fn factorial(comptime n: u32) u32 {
    var result: u32 = 1;
    var i: u32 = 1;
    while (i <= n) : (i += 1) {
        result *= i;
    }
    return result;
}

const fact10 = factorial(10); // computed at compile time

pub fn main() void {
    std.debug.print("10! = {d}\n", .{fact10});
}
```

#### 8.2 Generic Stack Type

```zig
fn Stack(comptime T: type, comptime capacity: usize) type {
    return struct {
        const Self = @This();
        buffer: [capacity]T = undefined,
        len: usize = 0,

        pub fn push(self: *Self, value: T) !void {
            if (self.len >= capacity) return error.Overflow;
            self.buffer[self.len] = value;
            self.len += 1;
        }

        pub fn pop(self: *Self) ?T {
            if (self.len == 0) return null;
            self.len -= 1;
            return self.buffer[self.len];
        }
    };
}

const IntStack = Stack(i32, 64);
```

#### 8.3 `@typeInfo`-Powered Serialization

```zig
fn printStruct(comptime T: type, value: T) void {
    const fields = @typeInfo(T).Struct.fields;
    inline for (fields) |field| {
        std.debug.print("{s}: {any}\n", .{ field.name, @field(value, field.name) });
    }
}

const Person = struct {
    name: []const u8,
    age: u32,
    active: bool,
};

pub fn main() void {
    const p = Person{ .name = "Alice", .age = 30, .active = true };
    printStruct(Person, p);
}
```

#### 8.4 Comptime Invariant Checking

```zig
fn requirePowerOfTwo(comptime n: u32) void {
    if (n == 0 or (n & (n - 1)) != 0) {
        @compileError(std.fmt.comptimePrint("{d} is not a power of two", .{n}));
    }
}

fn RingBuffer(comptime T: type, comptime size: u32) type {
    requirePowerOfTwo(size);
    return struct {
        buffer: [size]T = undefined,
        read_idx: u32 = 0,
        write_idx: u32 = 0,
    };
}

// RingBuffer(u8, 10); // compile error: 10 is not a power of two
const MyBuf = RingBuffer(u8, 16); // ok
```

#### 8.5 Comptime Table Generation for a Sine LUT

```zig
const sin_lut = blk: {
    const N = 256;
    var table: [N]f32 = undefined;
    var i: usize = 0;
    while (i < N) : (i += 1) {
        table[i] = @sin(2.0 * std.math.pi * @as(f32, @floatFromInt(i)) / @as(f32, @floatFromInt(N)));
    }
    break :blk table;
};

pub fn main() void {
    std.debug.print("sin(0) ~ {d}\n", .{sin_lut[0]});
}
```

All examples compile with `zig build-exe` and require no external files.

