## 8. Examples

All examples below are self‑contained; compile with `zig build-exe <file>.zig`.

### Example 1: Summing a Slice

```zig
const std = @import("std");

fn sumSlice(data: []const u32) u64 {
    var total: u64 = 0;
    for (data) |val| {
        total += val;
    }
    return total;
}

pub fn main() !void {
    const array = [_]u32{ 1, 2, 3, 4, 5 };
    const result = sumSlice(&array);
    std.debug.print("Sum: {}\n", .{result});
}
```

### Example 2: Safe Null Pointer Handling

```zig
const std = @import("std");

fn incrementOrZero(opt: ?*u32) u32 {
    if (opt) |ptr| {
        ptr.* += 1;
        return ptr.*;
    } else {
        return 0;
    }
}

pub fn main() !void {
    var x: u32 = 10;
    const a = incrementOrZero(&x);   // 11
    const b = incrementOrZero(null); // 0
    std.debug.print("a={}, b={}\n", .{ a, b });
}
```

### Example 3: Sentinel Slice with C’s `printf`

```zig
const std = @import("std");
const c = @cImport(@cInclude("stdio.h"));

pub fn main() void {
    const greeting: [:0]const u8 = "Hello, Zig!";
    _ = c.printf("%s\n", greeting.ptr); // coercion to [*:0]const u8
}
```

Build with `zig build-exe example.zig -lc`.

### Example 4: Pointer to Array for Fixed‑Size Buffers

```zig
const std = @import("std");

fn fillBuffer(buf: *[64]u8) void {
    for (buf, 0..) |*byte, i| {
        byte.* = @intCast(i % 256);
    }
}

pub fn main() !void {
    var buffer: [64]u8 = undefined;
    fillBuffer(&buffer);
    // buffer now contains 0..63
    std.debug.print("Last byte: {}\n", .{buffer[63]});
}
```

### Example 5: Converting C Pointer+Length to Slice

```zig
const std = @import("std");

fn processData(ptr: [*]const u8, len: usize) void {
    const slice: []const u8 = ptr[0..len];
    // Now you can use slice with bounds checking (in safe modes)
    for (slice) |byte| {
        // ...
    }
}
```

