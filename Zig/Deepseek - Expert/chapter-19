### 8. Examples

#### 8.1 Bounds check that saves you in Debug, bites you in ReleaseFast

```zig
const std = @import("std");

pub fn main() void {
    var buf: [4]u8 = undefined;
    for (0..10) |i| {
        buf[i] = @intCast(i); // will panic in Debug/ReleaseSafe, silent UB in ReleaseFast
    }
}
```

Compile and run:

```
$ zig build-exe unsafe_bounds.zig
$ ./unsafe_bounds
index 4 out of bounds for array of size 4

$ zig build-exe unsafe_bounds.zig -O ReleaseFast
$ ./unsafe_bounds
# no output; writes past the array, corrupting the stack
```

To fix it, always bound-check manually if you must use ReleaseFast, or stay in ReleaseSafe.

#### 8.2 Per-scope safety toggle with measured impact

```zig
const std = @import("std");

fn sum_safe(slice: []const u32) u64 {
    var total: u64 = 0;
    for (slice) |x| total += x;
    return total;
}

fn sum_fast(slice: []const u32) u64 {
    @setRuntimeSafety(false);
    var total: u64 = 0;
    for (slice) |x| total += x;
    return total;
}

pub fn main() !void {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const slice = try allocator.alloc(u32, 10_000_000);
    defer allocator.free(slice);
    @memset(slice, 1);

    var timer = try std.time.Timer.start();
    _ = sum_safe(slice);
    const safe_ns = timer.read();

    timer.reset();
    _ = sum_fast(slice);
    const fast_ns = timer.read();

    std.debug.print("safe: {d} ns, fast: {d} ns\n", .{ safe_ns, fast_ns });
}
```

Compile in ReleaseSafe to see the overhead; the difference is often a few percent.

#### 8.3 Structured logging with compile-time filtering

```zig
const std = @import("std");
const log = std.log.scoped(.database);

pub fn main() void {
    log.info("server starting on port {}", .{8080});   // always prints
    log.debug("parsed config: {}", .{@as(u8, 42)});    // elided unless -Dlog-level=debug
}
```

Compile with default (info level) and then with debug:

```
$ zig build-exe log_example.zig
$ ./log_example
info: server starting on port 8080

$ zig build-exe log_example.zig -Dlog-level=debug
$ ./log_example
info: server starting on port 8080
debug: parsed config: 42
```

#### 8.4 Debugging with GDB

Assume we have a simple program `crash.zig`:

```zig
pub fn main() void {
    const slice: []const u8 = &.{ 1, 2, 3 };
    _ = slice[5]; // out of bounds
}
```

Compile with debug info:

```
$ zig build-exe crash.zig -femit-bin=crash -O Debug
$ gdb ./crash
(gdb) run
Program received signal SIGABRT
(gdb) bt
#0  ... in panic ...
#1  ... in main ...
(gdb) frame 1
(gdb) list
```

The stack trace will show the exact line. For ReleaseSafe, ensure debug info is emitted (`.emit_debug_info = .{ .dwarf = .{} }` in build.zig) to get meaningful variable inspection.

