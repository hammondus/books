### 8. Examples

#### Example 1: HTTP Client with JSON Response Parsing

This example fetches a JSON endpoint, parses it with `std.json`, and prints a field. It handles errors and cleans up.

```zig
const std = @import("std");

pub fn main() !void {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    var client = std.http.Client{ .allocator = allocator };
    defer client.deinit();

    const uri = try std.Uri.parse("https://api.github.com/repos/ziglang/zig");
    var request = try client.request(.GET, uri, .{ .allocator = allocator }, .{});
    defer request.deinit();

    try request.start();
    try request.wait();

    var response = try request.reader();
    const body = try response.readAllAlloc(allocator, 10 * 1024 * 1024);
    defer allocator.free(body);

    if (response.status != .ok) {
        std.log.err("Request failed: status={d}", .{response.status});
        return error.HttpError;
    }

    // Simple JSON field extraction (for a robust solution, use std.json.Value)
    var stream = std.json.TokenStream.init(body);
    const root = try std.json.parse(std.json.Value, &stream, .{ .allocator = allocator });
    defer root.deinit();

    const full_name = root.object.get("full_name") orelse return error.MissingField;
    std.debug.print("Zig repository: {s}\n", .{full_name.string});
}
```

#### Example 2: HTTP Server with Static File Serving and Middleware

A server that serves a single file and logs requests.

```zig
const std = @import("std");

const Handler = struct {
    allocator: std.mem.Allocator,
    file_content: []const u8,

    pub fn handle(self: *Handler, request: *std.http.Server.Request, response: *std.http.Server.Response) void {
        defer request.deinit();
        errdefer response.deinit();

        const path = request.head.target;
        if (std.mem.eql(u8, path, "/")) {
            response.status = .ok;
            response.headers.content_type = .{ .override = "text/html" };
            response.transfer_encoding = .{ .content_length = self.file_content.len };
            response.do() catch return;
            _ = response.writer().writeAll(self.file_content) catch return;
            response.end() catch return;
        } else {
            response.status = .not_found;
            response.headers.content_type = .{ .override = "text/plain" };
            const body = "404 - Not Found\n";
            response.transfer_encoding = .{ .content_length = body.len };
            response.do() catch return;
            _ = response.writer().writeAll(body) catch return;
            response.end() catch return;
        }
    }
};

fn loggingMiddleware(inner: *const Handler) Handler {
    return Handler{
        .allocator = inner.allocator,
        .file_content = inner.file_content, // pass through
        // By embedding a custom handle function, we demonstrate middleware composition.
    };
}

pub fn main() !void {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const file_content = try std.fs.cwd().readFileAlloc(allocator, "index.html", 1024 * 1024);
    defer allocator.free(file_content);

    var base_handler = Handler{ .allocator = allocator, .file_content = file_content };
    // For brevity, the middleware is not active; you'd wrap base_handler with loggingMiddleware.
    // See the Best Practices section for the composition.

    var server = std.http.Server.init(allocator, .{ .reuse_address = true });
    defer server.deinit();

    std.log.info("Serving on http://127.0.0.1:8080", .{});
    try server.listen(try std.net.Address.parseIp4("127.0.0.1", 8080), &base_handler);
}
```

