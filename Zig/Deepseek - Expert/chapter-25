### 8. Examples

#### Example 1: Worker pool with WaitGroup and Mutex

```zig
const std = @import("std");

const Task = struct {
    id: u32,
};

const WorkerPool = struct {
    allocator: std.mem.Allocator,
    mutex: std.Thread.Mutex,
    tasks: std.ArrayList(Task),
    wg: std.Thread.WaitGroup,

    fn init(allocator: std.mem.Allocator) WorkerPool {
        return .{
            .allocator = allocator,
            .mutex = .{},
            .tasks = std.ArrayList(Task).init(allocator),
            .wg = .{},
        };
    }

    fn deinit(self: *WorkerPool) void {
        self.tasks.deinit();
    }

    fn addTask(self: *WorkerPool, task: Task) !void {
        self.mutex.lock();
        defer self.mutex.unlock();
        try self.tasks.append(task);
    }

    fn runWorker(self: *WorkerPool) void {
        self.wg.start();
        defer self.wg.finish();

        while (true) {
            self.mutex.lock();
            if (self.tasks.items.len == 0) {
                self.mutex.unlock();
                break;
            }
            const task = self.tasks.pop() orelse unreachable;
            self.mutex.unlock();

            // Simulate work
            std.time.sleep(10 * std.time.ns_per_ms);
        }
    }

    fn wait(self: *WorkerPool) void {
        self.wg.wait();
    }
};

test "worker pool" {
    var pool = WorkerPool.init(std.testing.allocator);
    defer pool.deinit();

    try pool.addTask(.{ .id = 1 });
    try pool.addTask(.{ .id = 2 });

    const thread = try std.Thread.spawn(.{}, WorkerPool.runWorker, .{&pool});
    pool.wait(); // wait for worker to drain tasks
    thread.join();

    // No tasks remain
    pool.mutex.lock();
    defer pool.mutex.unlock();
    try std.testing.expectEqual(@as(usize, 0), pool.tasks.items.len);
}
```

#### Example 2: Signal shutdown with ResetEvent

```zig
const std = @import("std");

fn run(event: *std.Thread.ResetEvent, id: u32) void {
    std.log.info("worker {d} waiting for start", .{id});
    event.wait();
    std.log.info("worker {d} running", .{id});
}

test "ResetEvent broadcast" {
    var event: std.Thread.ResetEvent = .{};

    const t1 = try std.Thread.spawn(.{}, run, .{ &event, 1 });
    const t2 = try std.Thread.spawn(.{}, run, .{ &event, 2 });

    std.time.sleep(100 * std.time.ns_per_ms);
    event.set();

    t1.join();
    t2.join();
}
```

#### Example 3: Lock‑free multi‑producer, multi‑consumer queue

```zig
const std = @import("std");

const Message = struct {
    data: i32,
    next: ?*Message = null,
};

test "atomic queue MP/MC" {
    const allocator = std.testing.allocator;
    var queue: std.atomic.Queue(Message) = .{};

    // Two producers
    const p1 = try std.Thread.spawn(.{}, struct {
        fn f(q: *std.atomic.Queue(Message), alloc: std.mem.Allocator) void {
            for (0..5) |i| {
                const msg = alloc.create(Message) catch unreachable;
                msg.data = @intCast(i);
                msg.next = null;
                q.put(msg);
            }
        }
    }.f, .{ &queue, allocator });

    const p2 = try std.Thread.spawn(.{}, struct {
        fn f(q: *std.atomic.Queue(Message), alloc: std.mem.Allocator) void {
            for (5..10) |i| {
                const msg = alloc.create(Message) catch unreachable;
                msg.data = @intCast(i);
                msg.next = null;
                q.put(msg);
            }
        }
    }.f, .{ &queue, allocator });

    p1.join();
    p2.join();

    // One consumer collects all messages
    var count: u32 = 0;
    while (queue.get()) |msg| {
        count += 1;
        allocator.destroy(msg);
    }

    try std.testing.expectEqual(@as(u32, 10), count);
}
```

