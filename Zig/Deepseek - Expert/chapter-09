### 8. Examples

Let’s build a small but realistic project that demonstrates all the concepts.

**Project structure:**

```
myproj/
├── build.zig
├── build.zig.zon
├── src/
│   ├── main.zig
│   ├── lib.zig
│   ├── math.zig
│   └── geometry/
│       └── vector.zig
```

**`math.zig`** – a basic math module:

```zig
// src/math.zig
pub fn add(a: f64, b: f64) f64 {
    return a + b;
}

pub fn multiply(a: f64, b: f64) f64 {
    return a * b;
}

test "add" {
    try std.testing.expectEqual(5.0, add(2, 3));
}

const std = @import("std");
```

**`geometry/vector.zig`** – uses `math.zig` via a relative import:

```zig
// src/geometry/vector.zig
const math = @import("../math.zig");

pub const Vec3 = struct {
    x: f64,
    y: f64,
    z: f64,

    pub fn scale(self: Vec3, s: f64) Vec3 {
        return .{
            .x = math.multiply(self.x, s),
            .y = math.multiply(self.y, s),
            .z = math.multiply(self.z, s),
        };
    }
};

test "scale" {
    const v = Vec3{ .x = 1, .y = 2, .z = 3 };
    const scaled = v.scale(2);
    try std.testing.expectEqual(Vec3{ .x = 2, .y = 4, .z = 6 }, scaled);
}

const std = @import("std");
```

**`lib.zig`** – the package root that exposes a unified public API:

```zig
// src/lib.zig
pub const math = @import("math.zig");
pub const vec = @import("geometry/vector.zig");

test {
    _ = math;
    _ = vec;
}
```

**`main.zig`** – the executable, using the `mylib` package:

```zig
const std = @import("std");
const mylib = @import("mylib");

pub fn main() !void {
    const v = mylib.vec.Vec3{ .x = 1, .y = 2, .z = 3 };
    const scaled = v.scale(2);
    std.debug.print("({d}, {d}, {d})\n", .{ scaled.x, scaled.y, scaled.z });
}
```

**`build.zig`** – registers the package and links it:

```zig
const std = @import("std");

pub fn build(b: *std.Build) void {
    const target = b.standardTargetOptions(.{});
    const optimize = b.standardOptimizeOption(.{});

    const lib_module = b.addModule("mylib", .{
        .root_source_file = b.path("src/lib.zig"),
        .target = target,
        .optimize = optimize,
    });

    const exe = b.addExecutable(.{
        .name = "myproj",
        .root_source_file = b.path("src/main.zig"),
        .target = target,
        .optimize = optimize,
    });
    exe.root_module.addImport("mylib", lib_module);
    b.installArtifact(exe);

    const lib_tests = b.addTest(.{
        .root_module = lib_module,
    });
    const run_lib_tests = b.addRunArtifact(lib_tests);
    const test_step = b.step("test", "Run library tests");
    test_step.dependOn(&run_lib_tests.step);
}
```

With this setup, `zig build` compiles the executable, and `zig build test` runs all tests in `math.zig` and `vector.zig` (because the root’s test block references them). The import `@import("mylib")` works from any file that has the package added to its module—here only `main.zig`, but you could also add it to internal modules if needed.

**Adding a third‑party dependency** is just as straightforward. Suppose we want to use a community library `zap` (a HTTP framework). Add to `build.zig.zon`:

```zig
.{
    .name = "myproj",
    .version = "0.1.0",
    .dependencies = .{
        .zap = .{
            .url = "https://github.com/zigzap/zap/archive/v0.1.0.tar.gz",
            .hash = "1220...",
        },
    },
    .paths = .{ "src", "build.zig", "build.zig.zon" },
}
```

Then in `build.zig`:

```zig
const zap_dep = b.dependency("zap", .{
    .target = target,
    .optimize = optimize,
});
exe.root_module.addImport("zap", zap_dep.module("zap"));
```

Now `@import("zap")` is available in `main.zig`. The Zig build system will download and verify the hash, cache it, and make the dependency’s modules available.

